/*
 * CIRCLE GROUP OPERATIONS
 *
 * Points on x^2 + y^2 = 1 over M31.
 * The circle group has order P+1 = 2^31, giving natural power-of-2 subgroups.
 *
 * Group operation is identical to CM31 multiplication:
 *   (x1,y1) * (x2,y2) = (x1*x2 - y1*y2, x1*y2 + y1*x2)
 *
 * Identity: (1, 0)
 * Inverse:  (x, -y)
 *
 * Squaring map (used in FRI domain halving):
 *   pi(x, y) = (2x^2 - 1, 2xy)
 */

// ============================================================
// M31 arithmetic (duplicated from m31.simf)
// ============================================================

fn m31_add(a: u32, b: u32) -> u32 {
    let (_, sum): (bool, u32) = jet::add_32(a, b);
    match jet::le_32(0x7fffffff, sum) {
        true => {
            let (_, r): (bool, u32) = jet::subtract_32(sum, 0x7fffffff);
            r
        },
        false => sum,
    }
}

fn m31_neg(a: u32) -> u32 {
    match jet::eq_32(a, 0) {
        true => 0,
        false => {
            let (_, r): (bool, u32) = jet::subtract_32(0x7fffffff, a);
            r
        },
    }
}

fn m31_sub(a: u32, b: u32) -> u32 {
    m31_add(a, m31_neg(b))
}

fn m31_mul(a: u32, b: u32) -> u32 {
    let prod: u64 = jet::multiply_32(a, b);
    let (hi, lo): (u32, u32) = <u64>::into(prod);
    let upper: u32 = jet::left_shift_32(1, hi);
    let lo_top: u32 = jet::right_shift_32(31, lo);
    let (_, shifted): (bool, u32) = jet::add_32(upper, lo_top);
    let lower: u32 = jet::and_32(lo, 0x7fffffff);
    m31_add(shifted, lower)
}

fn m31_inv_step(acc: u32, base: u32, ctr: u8) -> Either<u32, u32> {
    let acc: u32 = m31_mul(acc, acc);
    let acc: u32 = match jet::eq_8(ctr, 28) {
        true => acc,
        false => m31_mul(acc, base),
    };
    match jet::eq_8(ctr, 29) {
        true => Left(acc),
        false => Right(acc),
    }
}

fn m31_inv(a: u32) -> u32 {
    let result: Either<u32, u32> = for_while::<m31_inv_step>(a, a);
    unwrap_left::<u32>(result)
}

// ============================================================
// Circle point operations
// ============================================================

// Circle group multiplication (= complex multiplication)
fn circle_mul(p1: (u32, u32), p2: (u32, u32)) -> (u32, u32) {
    let (x1, y1): (u32, u32) = p1;
    let (x2, y2): (u32, u32) = p2;
    (m31_sub(m31_mul(x1, x2), m31_mul(y1, y2)),
     m31_add(m31_mul(x1, y2), m31_mul(y1, x2)))
}

// Circle point squaring map: pi(x,y) = (2x^2 - 1, 2xy)
fn circle_double(p: (u32, u32)) -> (u32, u32) {
    let (x, y): (u32, u32) = p;
    let x_sq: u32 = m31_mul(x, x);
    (m31_sub(m31_add(x_sq, x_sq), 1), m31_add(m31_mul(x, y), m31_mul(x, y)))
}

// Conjugate (inverse in circle group): (x, y) -> (x, -y)
fn circle_conj(p: (u32, u32)) -> (u32, u32) {
    let (x, y): (u32, u32) = p;
    (x, m31_neg(y))
}

// Repeated squaring: apply circle_double n times
// circle_double_n(p, n) = pi^n(p)
fn circle_double_1(p: (u32, u32)) -> (u32, u32) { circle_double(p) }
fn circle_double_2(p: (u32, u32)) -> (u32, u32) { circle_double(circle_double(p)) }
fn circle_double_3(p: (u32, u32)) -> (u32, u32) { circle_double(circle_double(circle_double(p))) }

// Generator of the full circle group (order 2^31)
// G = (x, y) where x^2 + y^2 = 1, order = 2^31
// Standard generator: (2, 1268011823)
// Verify: 2^2 + 1268011823^2 = 4 + 1607854053129751929 = ... mod P = 1
fn circle_gen() -> (u32, u32) {
    (2, 1268011823)
}

// Subgroup generator of order 2^k = G^(2^(31-k))
// For k=31: G itself
// For k=30: circle_double(G)
// etc.
// We precompute the ones we need for the evaluation domain.

// Generator of order 2^12 (for domain size 4096): G^(2^19) = double G 19 times
fn circle_double_step(p: (u32, u32), unused: (), ctr: u8) -> Either<(u32, u32), (u32, u32)> {
    let p: (u32, u32) = circle_double(p);
    match jet::eq_8(ctr, 18) {
        true => Left(p),
        false => Right(p),
    }
}

fn subgroup_gen_12() -> (u32, u32) {
    // G^(2^19) = circle_double applied 19 times to G
    let g: (u32, u32) = circle_gen();
    let result: Either<(u32, u32), (u32, u32)> = for_while::<circle_double_step>(g, ());
    unwrap_left::<(u32, u32)>(result)
}

// Compute domain point at a given index using bit-reversed ordering.
// domain[i] = coset_offset * subgroup_gen^(bit_reverse(i))
// For simplicity, we'll compute subgroup_gen^i using repeated multiplication.

// Compute g^n for small n via repeated multiplication
fn circle_pow_step(state: ((u32, u32), u32), gen: (u32, u32), ctr: u8) -> Either<(u32, u32), ((u32, u32), u32)> {
    let (acc, remaining): ((u32, u32), u32) = state;
    match jet::eq_32(remaining, 0) {
        true => Left(acc),
        false => {
            let acc: (u32, u32) = circle_mul(acc, gen);
            let (_, remaining): (bool, u32) = jet::subtract_32(remaining, 1);
            Right((acc, remaining))
        },
    }
}

fn circle_pow(gen: (u32, u32), n: u32) -> (u32, u32) {
    let init: ((u32, u32), u32) = ((1, 0), n);
    let result: Either<(u32, u32), ((u32, u32), u32)> = for_while::<circle_pow_step>(init, gen);
    unwrap_left::<((u32, u32), u32)>(result)
}

// ============================================================
// Tests
// ============================================================

fn main() {
    // Identity
    let id: (u32, u32) = (1, 0);
    let g: (u32, u32) = circle_gen();

    // g * id = g
    let (gx, gy): (u32, u32) = circle_mul(g, id);
    let (gen_x, gen_y): (u32, u32) = g;
    assert!(jet::eq_32(gx, gen_x));
    assert!(jet::eq_32(gy, gen_y));

    // Verify generator is on the circle: x^2 + y^2 = 1 mod P
    let x_sq: u32 = m31_mul(gen_x, gen_x);
    let y_sq: u32 = m31_mul(gen_y, gen_y);
    let sum: u32 = m31_add(x_sq, y_sq);
    assert!(jet::eq_32(sum, 1));

    // g * conj(g) = (x^2+y^2, 0) = (1, 0)
    let g_inv: (u32, u32) = circle_conj(g);
    let (prod_x, prod_y): (u32, u32) = circle_mul(g, g_inv);
    assert!(jet::eq_32(prod_x, 1));
    assert!(jet::eq_32(prod_y, 0));

    // circle_double: pi(1, 0) = (2*1-1, 0) = (1, 0)
    let (dx, dy): (u32, u32) = circle_double(id);
    assert!(jet::eq_32(dx, 1));
    assert!(jet::eq_32(dy, 0));

    // circle_double(g) is on the circle
    let (d_gx, d_gy): (u32, u32) = circle_double(g);
    let chk: u32 = m31_add(m31_mul(d_gx, d_gx), m31_mul(d_gy, d_gy));
    assert!(jet::eq_32(chk, 1));

    // circle_pow(g, 0) = identity
    let (p0x, p0y): (u32, u32) = circle_pow(g, 0);
    assert!(jet::eq_32(p0x, 1));
    assert!(jet::eq_32(p0y, 0));

    // circle_pow(g, 1) = g
    let (p1x, p1y): (u32, u32) = circle_pow(g, 1);
    assert!(jet::eq_32(p1x, gen_x));
    assert!(jet::eq_32(p1y, gen_y));

    // circle_pow(g, 2) = g * g
    let g2: (u32, u32) = circle_mul(g, g);
    let (p2x, p2y): (u32, u32) = circle_pow(g, 2);
    let (g2x, g2y): (u32, u32) = g2;
    assert!(jet::eq_32(p2x, g2x));
    assert!(jet::eq_32(p2y, g2y));

    // subgroup_gen_12 is on the circle
    let (sg_x, sg_y): (u32, u32) = subgroup_gen_12();
    let sg_chk: u32 = m31_add(m31_mul(sg_x, sg_x), m31_mul(sg_y, sg_y));
    assert!(jet::eq_32(sg_chk, 1));

    // subgroup_gen_12^(2^12) should be the identity (order 2^12 = 4096)
    // We verify subgroup_gen_12^4 is still on the circle (full order test too expensive)
    let sg4: (u32, u32) = circle_pow(subgroup_gen_12(), 4);
    let (sg4x, sg4y): (u32, u32) = sg4;
    let sg4_chk: u32 = m31_add(m31_mul(sg4x, sg4x), m31_mul(sg4y, sg4y));
    assert!(jet::eq_32(sg4_chk, 1));
}
