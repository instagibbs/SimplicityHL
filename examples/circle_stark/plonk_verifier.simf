    let cr: QM31 = qm31_mul(ap, (nr, (0, 0)));
    let term1_l: QM31 = qm31_add(term1_l, cl);
    let term1_r: QM31 = qm31_add(term1_r, cr);

    // Pair vanishing denominators
    let pv_a: (u32, u32) = (0x5454592b, 0x7b7c86e2);
    let pv_b: (u32, u32) = (0x08a7191e, 0x11a20273);
    let t_oods: (u32, u32) = cm31_add(pv_b, (q_px, 0));
    let s_oods: (u32, u32) = cm31_scale(pv_a, q_py);
    let dinv_oods_l: (u32, u32) = cm31_inv(cm31_sub(t_oods, s_oods));
    let dinv_oods_r: (u32, u32) = cm31_inv(cm31_add(t_oods, s_oods));
    let pvs_a: (u32, u32) = (0x3ed4ad91, 0x622d5566);
    let pvs_b: (u32, u32) = (0x039b68ae, 0x30ef8540);
    let t_shift: (u32, u32) = cm31_add(pvs_b, (q_px, 0));
    let s_shift: (u32, u32) = cm31_scale(pvs_a, q_py);
    let dinv_shift_l: (u32, u32) = cm31_inv(cm31_sub(t_shift, s_shift));
    let dinv_shift_r: (u32, u32) = cm31_inv(cm31_add(t_shift, s_shift));

    // Quotient assembly
    let q_l: QM31 = qm31_add(qm31_mul(term1_l, (dinv_oods_l, (0, 0))), qm31_mul(term2_l, (dinv_shift_l, (0, 0))));
    let q_r: QM31 = qm31_add(qm31_mul(term1_r, (dinv_oods_r, (0, 0))), qm31_mul(term2_r, (dinv_shift_r, (0, 0))));

    // Circle-to-line fold
    let inv_py: u32 = m31_inv(q_py);
    let f0: QM31 = qm31_add(q_l, q_r);
    let f1: QM31 = qm31_scale(qm31_sub(q_l, q_r), inv_py);
    let cpa: QM31 = ((0x69bec7ae, 0x658dc4ba), (0x5a259ea5, 0x52f26408));
    let expected_fri0: QM31 = qm31_add(f0, qm31_mul(cpa, f1));

    let (fl0, fri_rest_0): (FriLayer0, ((QM31, u32, (u256, (u256, (u256, (u256, u256))))), ((QM31, u32, (u256, (u256, (u256, u256)))), ((QM31, u32, (u256, (u256, u256))), ((QM31, u32, (u256, u256)), (QM31, u32, u256)))))) = fri_data;
    let (fv0, fi0, fsibs0): (QM31, u32, (u256, (u256, (u256, (u256, (u256, u256)))))) = fl0;
    let h: u256 = hash_qm31(fv0);
    let (fs0_0, fsr0_0): (u256, (u256, (u256, (u256, (u256, u256))))) = fsibs0;
    let h: u256 = merkle_step(h, fs0_0, get_bit(fi0, 0));
    let (fs0_1, fsr0_1): (u256, (u256, (u256, (u256, u256)))) = fsr0_0;
    let h: u256 = merkle_step(h, fs0_1, get_bit(fi0, 1));
    let (fs0_2, fsr0_2): (u256, (u256, (u256, u256))) = fsr0_1;
    let h: u256 = merkle_step(h, fs0_2, get_bit(fi0, 2));
    let (fs0_3, fsr0_3): (u256, (u256, u256)) = fsr0_2;
    let h: u256 = merkle_step(h, fs0_3, get_bit(fi0, 3));
    let (fs0_4, fsr0_4): (u256, u256) = fsr0_3;
    let h: u256 = merkle_step(h, fs0_4, get_bit(fi0, 4));
    let fs0_5: u256 = fsr0_4;
    let h: u256 = merkle_step(h, fs0_5, get_bit(fi0, 5));
    assert!(jet::eq_256(h, 0x541b709240d3afcb3e05146f3f649f5ad1f20ce8e5c86d31e428585128fc5a65));
    let (fl1, fri_rest_1): (FriLayer1, ((QM31, u32, (u256, (u256, (u256, u256)))), ((QM31, u32, (u256, (u256, u256))), ((QM31, u32, (u256, u256)), (QM31, u32, u256))))) = fri_rest_0;
    let (fv1, fi1, fsibs1): (QM31, u32, (u256, (u256, (u256, (u256, u256))))) = fl1;
    let h: u256 = hash_qm31(fv1);
    let (fs1_0, fsr1_0): (u256, (u256, (u256, (u256, u256)))) = fsibs1;
    let h: u256 = merkle_step(h, fs1_0, get_bit(fi1, 0));
    let (fs1_1, fsr1_1): (u256, (u256, (u256, u256))) = fsr1_0;
    let h: u256 = merkle_step(h, fs1_1, get_bit(fi1, 1));
    let (fs1_2, fsr1_2): (u256, (u256, u256)) = fsr1_1;
    let h: u256 = merkle_step(h, fs1_2, get_bit(fi1, 2));
    let (fs1_3, fsr1_3): (u256, u256) = fsr1_2;
    let h: u256 = merkle_step(h, fs1_3, get_bit(fi1, 3));
    let fs1_4: u256 = fsr1_3;
    let h: u256 = merkle_step(h, fs1_4, get_bit(fi1, 4));
    assert!(jet::eq_256(h, 0x4eb0673b9f8be8d4230cace7632cb5b98d50f52a1e830f688ecbd41f80fde4c0));
    let (fl2, fri_rest_2): (FriLayer2, ((QM31, u32, (u256, (u256, u256))), ((QM31, u32, (u256, u256)), (QM31, u32, u256)))) = fri_rest_1;
    let (fv2, fi2, fsibs2): (QM31, u32, (u256, (u256, (u256, u256)))) = fl2;
    let h: u256 = hash_qm31(fv2);
    let (fs2_0, fsr2_0): (u256, (u256, (u256, u256))) = fsibs2;
    let h: u256 = merkle_step(h, fs2_0, get_bit(fi2, 0));
    let (fs2_1, fsr2_1): (u256, (u256, u256)) = fsr2_0;
    let h: u256 = merkle_step(h, fs2_1, get_bit(fi2, 1));
    let (fs2_2, fsr2_2): (u256, u256) = fsr2_1;
    let h: u256 = merkle_step(h, fs2_2, get_bit(fi2, 2));
    let fs2_3: u256 = fsr2_2;
    let h: u256 = merkle_step(h, fs2_3, get_bit(fi2, 3));
    assert!(jet::eq_256(h, 0xd0f97a323b0ea98fb4823a2b2e29b639ead321c24010811503651f2bb8c678dc));
    let (fl3, fri_rest_3): (FriLayer3, ((QM31, u32, (u256, u256)), (QM31, u32, u256))) = fri_rest_2;
    let (fv3, fi3, fsibs3): (QM31, u32, (u256, (u256, u256))) = fl3;
    let h: u256 = hash_qm31(fv3);
    let (fs3_0, fsr3_0): (u256, (u256, u256)) = fsibs3;
    let h: u256 = merkle_step(h, fs3_0, get_bit(fi3, 0));
    let (fs3_1, fsr3_1): (u256, u256) = fsr3_0;
    let h: u256 = merkle_step(h, fs3_1, get_bit(fi3, 1));
    let fs3_2: u256 = fsr3_1;
    let h: u256 = merkle_step(h, fs3_2, get_bit(fi3, 2));
    assert!(jet::eq_256(h, 0x6bc224aaeb2a603975b6a45bf49845ce5395e6d751834d039abcb0f98c700a92));
    let (fl4, fri_rest_4): (FriLayer4, (QM31, u32, u256)) = fri_rest_3;
    let (fv4, fi4, fsibs4): (QM31, u32, (u256, u256)) = fl4;
    let h: u256 = hash_qm31(fv4);
    let (fs4_0, fsr4_0): (u256, u256) = fsibs4;
    let h: u256 = merkle_step(h, fs4_0, get_bit(fi4, 0));
    let fs4_1: u256 = fsr4_0;
    let h: u256 = merkle_step(h, fs4_1, get_bit(fi4, 1));
    assert!(jet::eq_256(h, 0xccb86828bc358644dcd5e3e5d4c35905e8edd00d8d7c8bc6c1ba7a0e34fd429b));
    let fl5: FriLayer5 = fri_rest_4;
    let (fv5, fi5, fsibs5): (QM31, u32, u256) = fl5;
    let h: u256 = hash_qm31(fv5);
    let fs5_0: u256 = fsibs5;
    let h: u256 = merkle_step(h, fs5_0, get_bit(fi5, 0));
    assert!(jet::eq_256(h, 0x9693387f554dc65f9c0bdcd037cf69e70c211fa697b46558ab0744d1c896f6c3));
    // Verify DEEP quotient matches FRI entry
    let ((ef_a, ef_b), (ef_c, ef_d)): QM31 = expected_fri0;
    let ((fv_a, fv_b), (fv_c, fv_d)): QM31 = fv0;
    assert!(jet::eq_32(ef_a, fv_a));
    assert!(jet::eq_32(ef_b, fv_b));
    assert!(jet::eq_32(ef_c, fv_c));
    assert!(jet::eq_32(ef_d, fv_d));

    acc
}

