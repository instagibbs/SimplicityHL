    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, hl_3, ht_3, (0x00000000, 0x00000000), (0x4ecb98d9, 0x00000000));
    let ap: QM31 = ((0x00000001, 0x00000000), (0x00000000, 0x00000000));
