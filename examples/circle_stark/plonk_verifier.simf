    // Column ('comp', 1): alpha^2
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, hl_1, ht_1, (0x00000000, 0x00000000), (0x63037b33, 0x00000000));
    let ap: QM31 = ((0x5c3e297a, 0x68aa3df4), (0x5d4c4f22, 0x647bfd9e));
