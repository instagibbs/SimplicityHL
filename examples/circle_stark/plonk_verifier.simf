    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_6, it_6, (0x57e4d86f, 0x426b6026), (0x242271ca, 0x4bebda8e));
    let ap: QM31 = ((0x3fb3058f, 0x5d49c8df), (0x779a8652, 0x67563bc7));
