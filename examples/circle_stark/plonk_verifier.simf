    // Column ('const', 'c_wire'): alpha^5
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, cl_cw, ct_cw, (0x11001dfa, 0x60c79f9e), (0x798a9532, 0x409045d6));
