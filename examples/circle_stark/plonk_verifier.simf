    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, tl_mult, tt_mult, (0x1fc175f2, 0x083f5e8d), (0x63eb637e, 0x51679ab7));
    let ap: QM31 = ((0x1f95182c, 0x235ed045), (0x677d888f, 0x48acdff8));
