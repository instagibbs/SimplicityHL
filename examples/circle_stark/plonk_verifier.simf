    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_4, it_4, (0x40c9ef90, 0x596b3262), (0x2ed753cd, 0x6f191be3));
    let ap: QM31 = ((0x3f7e551b, 0x347df338), (0x67bb332b, 0x4fb95da1));
