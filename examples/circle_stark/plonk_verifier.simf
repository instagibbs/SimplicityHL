    // Column ('cum_shifted', 3): alpha^8
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_7, it_7, (0x644f308d, 0x60965b85), (0x047a36cc, 0x12619e77));
    let ap: QM31 = ((0x5faaf38a, 0x3f7bed68), (0x64f77aa4, 0x6ca401c6));
