    // Column ('const', 'a_wire'): alpha^7
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, cl_aw, ct_aw, (0x33b86602, 0x1fff82ef), (0x0145a513, 0x3228aa50));
    let ap: QM31 = ((0x3b17a7f6, 0x0f86ef28), (0x73fb4647, 0x4564fbf0));
