    assert!(jet::eq_256(h, 0x3a2809e8fc97f62f1d60332cd6e5e01846d161a168654ee4001dcfe25d1a97d3));

    // DEEP quotient: column-line numerators
    let term1_l: QM31 = ((0, 0), (0, 0));
    let term1_r: QM31 = ((0, 0), (0, 0));
    let term2_l: QM31 = ((0, 0), (0, 0));
    let term2_r: QM31 = ((0, 0), (0, 0));
