    // Column ('const', 'op'): alpha^4
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, cl_op, ct_op, (0x6ea3dbfb, 0x60640e57), (0x7c22780f, 0x0733cdc3));
    let ap: QM31 = ((0x3141907e, 0x375a8176), (0x2b9f189c, 0x7faf66d3));
