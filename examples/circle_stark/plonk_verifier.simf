    // Column ('comp', 0): alpha^3
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, hl_0, ht_0, (0x00000000, 0x00000000), (0x2308d6f6, 0x00000000));
    let ap: QM31 = ((0x0cc19fe1, 0x0ce37062), (0x355a2e8d, 0x5bd0cd10));
