    assert!(jet::eq_256(h, 0x755c31902b627538ee3a385014fae6c4c0ac2c3b397884515bc7750accecd6eb));

    let (comp_left, comp_twin, comp_path, comp_twin_path): (Col4, Col4, Sibs, Sibs) = comp_data;
    let (hl_0, hl_1, hl_2, hl_3): Col4 = comp_left;
    let (ht_0, ht_1, ht_2, ht_3): Col4 = comp_twin;
    let h: u256 = hash_4m31(hl_0, hl_1, hl_2, hl_3);
    let (hp_s0, hp_sr0): (u256, (u256, (u256, (u256, (u256, (u256, u256)))))) = comp_path;
    let h: u256 = merkle_step(h, hp_s0, get_bit(q_idx, 0));
    let (hp_s1, hp_sr1): (u256, (u256, (u256, (u256, (u256, u256))))) = hp_sr0;
    let h: u256 = merkle_step(h, hp_s1, get_bit(q_idx, 1));
    let (hp_s2, hp_sr2): (u256, (u256, (u256, (u256, u256)))) = hp_sr1;
