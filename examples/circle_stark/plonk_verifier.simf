    let term1_l: QM31 = qm31_add(term1_l, cl);
    let term1_r: QM31 = qm31_add(term1_r, cr);
    // Column ('logab', 2): alpha^17
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_2, it_2, (0x08a8932f, 0x6ffceb8f), (0x080a544c, 0x49dafeb2));
    let ap: QM31 = ((0x1ebf640b, 0x07d27ae8), (0x4cb95a69, 0x40fa05ac));
    let cl: QM31 = qm31_mul(ap, (nl, (0, 0)));
    let cr: QM31 = qm31_mul(ap, (nr, (0, 0)));
    let term1_l: QM31 = qm31_add(term1_l, cl);
    let term1_r: QM31 = qm31_add(term1_r, cr);
    // Column ('logab', 3): alpha^16
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_3, it_3, (0x284c403c, 0x3b761879), (0x20c5aac2, 0x4618b338));
    let ap: QM31 = ((0x377f7c75, 0x4ae02b67), (0x59cebf9c, 0x2573dd4b));
    let cl: QM31 = qm31_mul(ap, (nl, (0, 0)));
    let cr: QM31 = qm31_mul(ap, (nr, (0, 0)));
    let term1_l: QM31 = qm31_add(term1_l, cl);
    let term1_r: QM31 = qm31_add(term1_r, cr);
    // Column ('cum', 0): alpha^15
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_4, it_4, (0x24d03259, 0x6f3e8783), (0x3b416d54, 0x19811263));
    let ap: QM31 = ((0x2265c9b3, 0x42724601), (0x410fefd6, 0x158ec05c));
    let cl: QM31 = qm31_mul(ap, (nl, (0, 0)));
    let cr: QM31 = qm31_mul(ap, (nr, (0, 0)));
    let term1_l: QM31 = qm31_add(term1_l, cl);
    let term1_r: QM31 = qm31_add(term1_r, cr);
    // Column ('cum', 1): alpha^14
    let (nl, nr): ((u32, u32), (u32, u32)) = apply_twin(q_py, il_5, it_5, (0x1e1e6d12, 0x19b74c85), (0x159a7d38, 0x2a0613b2));
    let ap: QM31 = ((0x576d34e3, 0x5bc669b2), (0x54656120, 0x30300415));
