    let q35_f9_val: QM31 = ((0x56bb6339, 0x30184c60), (0x07f0291d, 0x076cfba8));
    let q35_f9_leaf: u256 = { let (a0, a1): QM31 = q35_f9_val; let (a0r, a0i): (u32, u32) = a0; let (a1r, a1i): (u32, u32) = a1; hash_qm31_leaf(a0r, a0i, a1r, a1i) };
