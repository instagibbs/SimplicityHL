    let q35_f8_leaf: u256 = { let (a0, a1): QM31 = q35_f8_val; let (a0r, a0i): (u32, u32) = a0; let (a1r, a1i): (u32, u32) = a1; hash_qm31_leaf(a0r, a0i, a1r, a1i) };
