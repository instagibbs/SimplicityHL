/*
 * BLS12-381 FINAL EXPONENTIATION
 *
 * Computes f^((p^12-1)/r) where f is the Miller loop output.
 * Uses: Fp12 conjugate, inverse, Frobenius maps, exp by BLS parameter.
 */

// Fp arithmetic via BLS12-381 jets
fn fm(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_multiply(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fa(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_add(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fs(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_subtract(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fp_to_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 0xf4df1f341c341746, 0x0a76e6a609d104f1, 0x8de5476c4c95b6d5, 0x67eb88a9939d83c0, 0x9a793e85b519952d, 0x11988fe592cae3aa) }
fn fp_from_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 1, 0, 0, 0, 0, 0) }
fn fp_eq(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool { match jet::eq_64(a0, b0) { false => false, true => match jet::eq_64(a1, b1) { false => false, true => match jet::eq_64(a2, b2) { false => false, true => match jet::eq_64(a3, b3) { false => false, true => match jet::eq_64(a4, b4) { false => false, true => jet::eq_64(a5, b5), }, }, }, }, } }
