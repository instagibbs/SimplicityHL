fn f2m(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64, a8: u64, a9: u64, a10: u64, a11: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64, b6: u64, b7: u64, b8: u64, b9: u64, b10: u64, b11: u64) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) { let (v0_0, v0_1, v0_2, v0_3, v0_4, v0_5): (u64, u64, u64, u64, u64, u64) = fm(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5); let (v1_0, v1_1, v1_2, v1_3, v1_4, v1_5): (u64, u64, u64, u64, u64, u64) = fm(a6, a7, a8, a9, a10, a11, b6, b7, b8, b9, b10, b11); let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fs(v0_0, v0_1, v0_2, v0_3, v0_4, v0_5, v1_0, v1_1, v1_2, v1_3, v1_4, v1_5); let (s0, s1, s2, s3, s4, s5): (u64, u64, u64, u64, u64, u64) = fa(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11); let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) = fa(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11); let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fm(s0, s1, s2, s3, s4, s5, t0, t1, t2, t3, t4, t5); let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fs(i0, i1, i2, i3, i4, i5, v0_0, v0_1, v0_2, v0_3, v0_4, v0_5); let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fs(i0, i1, i2, i3, i4, i5, v1_0, v1_1, v1_2, v1_3, v1_4, v1_5); (r0, r1, r2, r3, r4, r5, i0, i1, i2, i3, i4, i5) }
