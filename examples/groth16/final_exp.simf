// ============================================================
// Inversion helpers (from miller.simf)
// ============================================================

fn pk(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u256, u128) {
    (<((u64,u64),(u64,u64))>::into(((a3, a2), (a1, a0))), <(u64,u64)>::into((a5, a4)))
}

fn up(v: (u256, u128)) -> (u64, u64, u64, u64, u64, u64) {
    let (lo, hi): (u256, u128) = v;
    let ((a3, a2), (a1, a0)): ((u64, u64), (u64, u64)) = <u256>::into(lo);
    let (a5, a4): (u64, u64) = <u128>::into(hi);
    (a0, a1, a2, a3, a4, a5)
}

fn shl384(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) {
    let zero: u1 = 0;
    let (c0, r0): (u1, u64) = jet::full_left_shift_64_1(a0, zero);
    let (c1, r1): (u1, u64) = jet::full_left_shift_64_1(a1, c0);
    let (c2, r2): (u1, u64) = jet::full_left_shift_64_1(a2, c1);
    let (c3, r3): (u1, u64) = jet::full_left_shift_64_1(a3, c2);
    let (c4, r4): (u1, u64) = jet::full_left_shift_64_1(a4, c3);
    let (_, r5): (u1, u64) = jet::full_left_shift_64_1(a5, c4);
    (r0, r1, r2, r3, r4, r5)
}

fn msb384(a5: u64) -> bool { jet::lt_64(0x7fffffffffffffff, a5) }

fn exp_step(
    state: ((u256, u128), (u256, u128)),
    base: (u256, u128),
    counter: u16
) -> Either<(u256, u128), ((u256, u128), (u256, u128))> {
    let (acc_packed, exp_packed): ((u256, u128), (u256, u128)) = state;
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) = up(acc_packed);
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) = up(exp_packed);
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) = fm(a0, a1, a2, a3, a4, a5, a0, a1, a2, a3, a4, a5);
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) = match msb384(e5) {
        true => { let (b0, b1, b2, b3, b4, b5): (u64, u64, u64, u64, u64, u64) = up(base); fm(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5) },
        false => (a0, a1, a2, a3, a4, a5),
    };
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) = shl384(e0, e1, e2, e3, e4, e5);
    match jet::eq_16(counter, 380) {
        true => Left(pk(a0, a1, a2, a3, a4, a5)),
        false => Right((pk(a0, a1, a2, a3, a4, a5), pk(e0, e1, e2, e3, e4, e5))),
    }
}

fn fp_inv_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) {
    let one_m: (u256, u128) = pk(0x760900000002fffd, 0xebf4000bc40c0002, 0x5f48985753c758ba, 0x77ce585370525745, 0x5c071a97a256ec6d, 0x15f65ec3fa80e493);
    let exp: (u256, u128) = pk(0xcff7fffffffd5548, 0xf55ffff58a9ffffd, 0x39869507b587b120, 0x23ba5c279c2895fb, 0x58dd3db21a5d66bb, 0xd0088f51cbff34d2);
    let base: (u256, u128) = pk(a0, a1, a2, a3, a4, a5);
    let init: ((u256, u128), (u256, u128)) = (one_m, exp);
    let result: Either<(u256, u128), ((u256, u128), (u256, u128))> = for_while::<exp_step>(init, base);
    let r: (u256, u128) = unwrap_left::<((u256, u128), (u256, u128))>(result);
    up(r)
}

