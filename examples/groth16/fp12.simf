    (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23)
}

// ============================================================
// Fp12 = Fp6[w] / (w^2 - v)
// Element: (a, b) each Fp6 (36 u64 each) = a + b*w
// Mul: (a0+a1*w)(b0+b1*w) = (a0*b0 + a1*b1*v) + (a0*b1+a1*b0)*w
// Uses Karatsuba: c1 = (a0+a1)(b0+b1) - a0*b0 - a1*b1
// ============================================================

