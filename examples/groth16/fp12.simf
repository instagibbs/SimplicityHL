fn main() {
    // Test Fp6 mul with small values in standard form, converted to Montgomery
    // a = (7+11u, 13+17u, 19+23u), b = (29+31u, 37+41u, 43+47u)
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(7, 0, 0, 0, 0, 0);
    let (a6, a7, a8, a9, a10, a11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(11, 0, 0, 0, 0, 0);
    let (a12, a13, a14, a15, a16, a17): (u64, u64, u64, u64, u64, u64) = fp_to_mont(13, 0, 0, 0, 0, 0);
    let (a18, a19, a20, a21, a22, a23): (u64, u64, u64, u64, u64, u64) = fp_to_mont(17, 0, 0, 0, 0, 0);
    let (a24, a25, a26, a27, a28, a29): (u64, u64, u64, u64, u64, u64) = fp_to_mont(19, 0, 0, 0, 0, 0);
    let (a30, a31, a32, a33, a34, a35): (u64, u64, u64, u64, u64, u64) = fp_to_mont(23, 0, 0, 0, 0, 0);
    let (b0, b1, b2, b3, b4, b5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(29, 0, 0, 0, 0, 0);
    let (b6, b7, b8, b9, b10, b11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(31, 0, 0, 0, 0, 0);
    let (b12, b13, b14, b15, b16, b17): (u64, u64, u64, u64, u64, u64) = fp_to_mont(37, 0, 0, 0, 0, 0);
    let (b18, b19, b20, b21, b22, b23): (u64, u64, u64, u64, u64, u64) = fp_to_mont(41, 0, 0, 0, 0, 0);
    let (b24, b25, b26, b27, b28, b29): (u64, u64, u64, u64, u64, u64) = fp_to_mont(43, 0, 0, 0, 0, 0);
    let (b30, b31, b32, b33, b34, b35): (u64, u64, u64, u64, u64, u64) = fp_to_mont(47, 0, 0, 0, 0, 0);

    let (c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11,
         c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23,
         c24, c25, c26, c27, c28, c29, c30, c31, c32, c33, c34, c35):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp6_mul(
            a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11,
            a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23,
            a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35,
            b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11,
            b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23,
            b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35
        );

    // Convert c0 (first Fp2) to standard form and verify
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fp_from_mont(c0, c1, c2, c3, c4, c5);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fp_from_mont(c6, c7, c8, c9, c10, c11);
    // c0_re from Python = p - 0x5d5b (negative small number)
    assert!(fp_eq(r0, r1, r2, r3, r4, r5,
        0xb9feffffffff9ca5, 0x1eabfffeb153ffff,
        0x6730d2a0f6b0f624, 0x64774b84f38512bf,
        0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a));
    // c0_im = 0xbd4
    assert!(fp_eq(i0, i1, i2, i3, i4, i5,
        0x0000000000000bd4, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000));

    // Check c1 component
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fp_from_mont(c12, c13, c14, c15, c16, c17);
    assert!(fp_eq(r0, r1, r2, r3, r4, r5,
        0xb9feffffffffa0f3, 0x1eabfffeb153ffff,
        0x6730d2a0f6b0f624, 0x64774b84f38512bf,
        0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a));

    // ===== Test Fp12 mul =====
    // a_hi = (53+59u, 61+67u, 71+73u), b_hi = (79+83u, 89+97u, 101+103u)
    let (a36, a37, a38, a39, a40, a41): (u64, u64, u64, u64, u64, u64) = fp_to_mont(53, 0, 0, 0, 0, 0);
    let (a42, a43, a44, a45, a46, a47): (u64, u64, u64, u64, u64, u64) = fp_to_mont(59, 0, 0, 0, 0, 0);
    let (a48, a49, a50, a51, a52, a53): (u64, u64, u64, u64, u64, u64) = fp_to_mont(61, 0, 0, 0, 0, 0);
    let (a54, a55, a56, a57, a58, a59): (u64, u64, u64, u64, u64, u64) = fp_to_mont(67, 0, 0, 0, 0, 0);
    let (a60, a61, a62, a63, a64, a65): (u64, u64, u64, u64, u64, u64) = fp_to_mont(71, 0, 0, 0, 0, 0);
    let (a66, a67, a68, a69, a70, a71): (u64, u64, u64, u64, u64, u64) = fp_to_mont(73, 0, 0, 0, 0, 0);
    let (b36, b37, b38, b39, b40, b41): (u64, u64, u64, u64, u64, u64) = fp_to_mont(79, 0, 0, 0, 0, 0);
    let (b42, b43, b44, b45, b46, b47): (u64, u64, u64, u64, u64, u64) = fp_to_mont(83, 0, 0, 0, 0, 0);
    let (b48, b49, b50, b51, b52, b53): (u64, u64, u64, u64, u64, u64) = fp_to_mont(89, 0, 0, 0, 0, 0);
    let (b54, b55, b56, b57, b58, b59): (u64, u64, u64, u64, u64, u64) = fp_to_mont(97, 0, 0, 0, 0, 0);
    let (b60, b61, b62, b63, b64, b65): (u64, u64, u64, u64, u64, u64) = fp_to_mont(101, 0, 0, 0, 0, 0);
    let (b66, b67, b68, b69, b70, b71): (u64, u64, u64, u64, u64, u64) = fp_to_mont(103, 0, 0, 0, 0, 0);

    let (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11,
         r12, r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23,
         r24, r25, r26, r27, r28, r29, r30, r31, r32, r33, r34, r35,
         r36, r37, r38, r39, r40, r41, r42, r43, r44, r45, r46, r47,
         r48, r49, r50, r51, r52, r53, r54, r55, r56, r57, r58, r59,
         r60, r61, r62, r63, r64, r65, r66, r67, r68, r69, r70, r71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_mul(
            a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11,
            a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23,
            a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35,
            a36, a37, a38, a39, a40, a41, a42, a43, a44, a45, a46, a47,
            a48, a49, a50, a51, a52, a53, a54, a55, a56, a57, a58, a59,
            a60, a61, a62, a63, a64, a65, a66, a67, a68, a69, a70, a71,
            b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11,
            b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23,
            b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35,
            b36, b37, b38, b39, b40, b41, b42, b43, b44, b45, b46, b47,
            b48, b49, b50, b51, b52, b53, b54, b55, b56, b57, b58, b59,
            b60, b61, b62, b63, b64, b65, b66, b67, b68, b69, b70, b71
        );

    // Check result[0][0] (first Fp2 of first Fp6)
    let (v0, v1, v2, v3, v4, v5): (u64, u64, u64, u64, u64, u64) = fp_from_mont(r0, r1, r2, r3, r4, r5);
    let (v6, v7, v8, v9, v10, v11): (u64, u64, u64, u64, u64, u64) = fp_from_mont(r6, r7, r8, r9, r10, r11);
    assert!(fp_eq(v0, v1, v2, v3, v4, v5,
        0xb9feffffffff0b53, 0x1eabfffeb153ffff,
        0x6730d2a0f6b0f624, 0x64774b84f38512bf,
        0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a));
    assert!(fp_eq(v6, v7, v8, v9, v10, v11,
        0x0000000000008b9e, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000));

    // Check result[1][0] (first Fp2 of second Fp6)
    let (v0, v1, v2, v3, v4, v5): (u64, u64, u64, u64, u64, u64) = fp_from_mont(r36, r37, r38, r39, r40, r41);
    let (v6, v7, v8, v9, v10, v11): (u64, u64, u64, u64, u64, u64) = fp_from_mont(r42, r43, r44, r45, r46, r47);
    assert!(fp_eq(v0, v1, v2, v3, v4, v5,
        0xb9feffffffff594f, 0x1eabfffeb153ffff,
        0x6730d2a0f6b0f624, 0x64774b84f38512bf,
        0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a));
    assert!(fp_eq(v6, v7, v8, v9, v10, v11,
        0x00000000000052f8, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000));
}
