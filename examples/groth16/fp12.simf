    let (c1_0, c1_1, c1_2, c1_3, c1_4, c1_5, c1_6, c1_7, c1_8, c1_9, c1_10, c1_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, xt0, xt1, xt2, xt3, xt4, xt5, xt6, xt7, xt8, xt9, xt10, xt11);
    // c2 = (a0+a2)(b0+b2) - t0 - t2 + t1
