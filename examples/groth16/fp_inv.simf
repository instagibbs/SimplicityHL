/*
 * BLS12-381 FIELD INVERSION via Fermat's little theorem
 *
 * a^{-1} = a^{p-2} mod p
 * Uses left-to-right square-and-multiply in a for_while loop.
 * Exponent (p-2) is pre-shifted left by 3 so MSB aligns with bit 383.
 * 381 iterations of: square acc, if top bit set multiply by base, shift exp.
 *
 * Phase 1c of Groth16 ZK proof verifier for SimplicityHL.
 */


// Fp arithmetic via BLS12-381 jets
fn fm(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_multiply(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fa(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_add(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fs(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_subtract(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fp_to_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 0xf4df1f341c341746, 0x0a76e6a609d104f1, 0x8de5476c4c95b6d5, 0x67eb88a9939d83c0, 0x9a793e85b519952d, 0x11988fe592cae3aa) }
fn fp_from_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 1, 0, 0, 0, 0, 0) }
fn fp_eq(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool { match jet::eq_64(a0, b0) { false => false, true => match jet::eq_64(a1, b1) { false => false, true => match jet::eq_64(a2, b2) { false => false, true => match jet::eq_64(a3, b3) { false => false, true => match jet::eq_64(a4, b4) { false => false, true => jet::eq_64(a5, b5), }, }, }, }, } }
fn fp_mul_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5) }

// ============================================================
// Packing: 6 u64 limbs <-> (u256, u128) for loop state
// u256 = ((u64_hi, u64), (u64, u64_lo))
// u128 = (u64_hi, u64_lo)
// Pack: limbs 0-3 into u256, limbs 4-5 into u128
// ============================================================

fn pack(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64
) -> (u256, u128) {
    let lo: u256 = <((u64, u64), (u64, u64))>::into(((a3, a2), (a1, a0)));
    let hi: u128 = <(u64, u64)>::into((a5, a4));
    (lo, hi)
}

fn unpack(v: (u256, u128)) -> (u64, u64, u64, u64, u64, u64) {
    let (lo, hi): (u256, u128) = v;
    let ((a3, a2), (a1, a0)): ((u64, u64), (u64, u64)) =
        <u256>::into(lo);
    let (a5, a4): (u64, u64) = <u128>::into(hi);
    (a0, a1, a2, a3, a4, a5)
}

// ============================================================
// 384-bit left shift by 1 (for exponent scanning)
// ============================================================

fn shl384(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64
) -> (u64, u64, u64, u64, u64, u64) {
    // full_left_shift_64_1(value, bit_in) -> (bit_out, shifted_value)
    // Shifts left by 1: MSB comes out, bit_in goes to LSB
    let zero: u1 = 0;
    let (c0, r0): (u1, u64) = jet::full_left_shift_64_1(a0, zero);
    let (c1, r1): (u1, u64) = jet::full_left_shift_64_1(a1, c0);
    let (c2, r2): (u1, u64) = jet::full_left_shift_64_1(a2, c1);
    let (c3, r3): (u1, u64) = jet::full_left_shift_64_1(a3, c2);
    let (c4, r4): (u1, u64) = jet::full_left_shift_64_1(a4, c3);
    let (_, r5): (u1, u64) = jet::full_left_shift_64_1(a5, c4);
    (r0, r1, r2, r3, r4, r5)
}

// Check if MSB (bit 63) of limb 5 is set
fn msb_set(a5: u64) -> bool {
    jet::lt_64(0x7fffffffffffffff, a5)
}

// ============================================================
// Exponentiation loop body for for_while
// State = ((u256, u128), (u256, u128)) = (acc_mont, exp_shifted)
// Env = (u256, u128) = base_mont
// Counter = u16
// ============================================================

fn exp_step(
    state: ((u256, u128), (u256, u128)),
    base: (u256, u128),
    counter: u16
) -> Either<(u256, u128), ((u256, u128), (u256, u128))> {
    let (acc_packed, exp_packed): ((u256, u128), (u256, u128)) = state;
    // Unpack accumulator
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) =
        unpack(acc_packed);
    // Unpack exponent
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) =
        unpack(exp_packed);
    // Square accumulator
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) =
        fp_mul_mont(a0, a1, a2, a3, a4, a5, a0, a1, a2, a3, a4, a5);
    // If MSB of exp is set, multiply by base
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) =
        match msb_set(e5) {
            true => {
                let (b0, b1, b2, b3, b4, b5): (u64, u64, u64, u64, u64, u64) =
                    unpack(base);
                fp_mul_mont(
                    a0, a1, a2, a3, a4, a5,
                    b0, b1, b2, b3, b4, b5
                )
            },
            false => (a0, a1, a2, a3, a4, a5),
        };
    // Shift exponent left by 1
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) =
        shl384(e0, e1, e2, e3, e4, e5);
    // After 381 iterations (counter 0..380), return result
    match jet::eq_16(counter, 380) {
        true => Left(pack(a0, a1, a2, a3, a4, a5)),
        false => Right((pack(a0, a1, a2, a3, a4, a5), pack(e0, e1, e2, e3, e4, e5))),
    }
}

// ============================================================
// Field inversion: a^{-1} mod p (standard form)
// ============================================================

fn fp_inv(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64
) -> (u64, u64, u64, u64, u64, u64) {
    // Convert to Montgomery form
    let (am0, am1, am2, am3, am4, am5): (u64, u64, u64, u64, u64, u64) =
        fp_to_mont(a0, a1, a2, a3, a4, a5);
    // Montgomery 1 = R mod p
    let one_mont: (u256, u128) = pack(
        0x760900000002fffd, 0xebf4000bc40c0002,
        0x5f48985753c758ba, 0x77ce585370525745,
        0x5c071a97a256ec6d, 0x15f65ec3fa80e493
    );
    // Exponent = (p-2) << 3, so MSB aligns with bit 383
    let exp: (u256, u128) = pack(
        0xcff7fffffffd5548, 0xf55ffff58a9ffffd,
        0x39869507b587b120, 0x23ba5c279c2895fb,
        0x58dd3db21a5d66bb, 0xd0088f51cbff34d2
    );
    let base: (u256, u128) = pack(am0, am1, am2, am3, am4, am5);
    let init_state: ((u256, u128), (u256, u128)) = (one_mont, exp);
    let result: Either<(u256, u128), ((u256, u128), (u256, u128))> =
        for_while::<exp_step>(init_state, base);
    let result_packed: (u256, u128) = unwrap_left::<((u256, u128), (u256, u128))>(result);
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        unpack(result_packed);
    // Convert back from Montgomery form
    fp_from_mont(r0, r1, r2, r3, r4, r5)
}

fn fp_mul(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64
) -> (u64, u64, u64, u64, u64, u64) {
    let (am0, am1, am2, am3, am4, am5): (u64, u64, u64, u64, u64, u64) =
        fp_to_mont(a0, a1, a2, a3, a4, a5);
    fm(am0, am1, am2, am3, am4, am5, b0, b1, b2, b3, b4, b5)
}

fn main() {
    // Test 1: inv(1) = 1
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(1, 0, 0, 0, 0, 0);
    assert!(fp_eq(r0, r1, r2, r3, r4, r5, 1, 0, 0, 0, 0, 0));

    // Test 2: inv(2) = (p+1)/2
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(2, 0, 0, 0, 0, 0);
    assert!(fp_eq(
        r0, r1, r2, r3, r4, r5,
        0xdcff7fffffffd556, 0x0f55ffff58a9ffff,
        0xb39869507b587b12, 0xb23ba5c279c2895f,
        0x258dd3db21a5d66b, 0x0d0088f51cbff34d
    ));

    // Test 3: inv(7) (precomputed)
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(7, 0, 0, 0, 0, 0);
    assert!(fp_eq(
        r0, r1, r2, r3, r4, r5,
        0xd16d924924923cf4, 0x0461b6db3de76db6,
        0xea2b8bcdda1947bc, 0x577ec1a5475c273f,
        0x7871aa3e9be63d43, 0x03b7028f2cc920f1
    ));

    // Test 4: Full-size inv(a) against precomputed reference
    let a0: u64 = 0x760900000002fffd;
    let a1: u64 = 0xebf4000bc40c0002;
    let a2: u64 = 0x5f48985753c758ba;
    let a3: u64 = 0xd77ce58537052574;
    let a4: u64 = 0x35c071a97a256ec6;
    let a5: u64 = 0x015f65ec3fa80e49;
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(a0, a1, a2, a3, a4, a5);
    assert!(fp_eq(
        i0, i1, i2, i3, i4, i5,
        0xa2e120640eb3ba84, 0x67e7b19954416490,
        0xb82524681aa25469, 0x4be84e054b5ccba4,
        0x2bb639cbafdf3223, 0x0be0af278e8c21d8
    ));

    // Test 5: a * inv(a) = 1 (round-trip)
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        fp_mul(a0, a1, a2, a3, a4, a5, i0, i1, i2, i3, i4, i5);
    assert!(fp_eq(r0, r1, r2, r3, r4, r5, 1, 0, 0, 0, 0, 0));

    // Test 6: inv(p-1) = p-1 (self-inverse since (p-1)^2 = 1)
    let pm1_0: u64 = 0xb9feffffffffaaaa;
    let pm1_1: u64 = 0x1eabfffeb153ffff;
    let pm1_2: u64 = 0x6730d2a0f6b0f624;
    let pm1_3: u64 = 0x64774b84f38512bf;
    let pm1_4: u64 = 0x4b1ba7b6434bacd7;
    let pm1_5: u64 = 0x1a0111ea397fe69a;
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(pm1_0, pm1_1, pm1_2, pm1_3, pm1_4, pm1_5);
    assert!(fp_eq(
        r0, r1, r2, r3, r4, r5,
        pm1_0, pm1_1, pm1_2, pm1_3, pm1_4, pm1_5
    ));

    // Test 7: inv(inv(a)) = a (double inversion)
    let (ii0, ii1, ii2, ii3, ii4, ii5): (u64, u64, u64, u64, u64, u64) =
        fp_inv(i0, i1, i2, i3, i4, i5);
    assert!(fp_eq(
        ii0, ii1, ii2, ii3, ii4, ii5,
        a0, a1, a2, a3, a4, a5
    ));

    // Test 8: inv(a*b) = inv(a) * inv(b)
    let b0: u64 = 0xf4df1f341c341746;
    let b1: u64 = 0x0a76e6a609d104f1;
    let b2: u64 = 0x8de5476c4c95b6d5;
    let b3: u64 = 0x67eb88a9939d83c0;
    let b4: u64 = 0x9a793e85b519952d;
    let b5: u64 = 0x11988fe592cae3aa;
    // inv(a*b)
    let (ab0, ab1, ab2, ab3, ab4, ab5): (u64, u64, u64, u64, u64, u64) =
        fp_mul(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let (inv_ab0, inv_ab1, inv_ab2, inv_ab3, inv_ab4, inv_ab5):
        (u64, u64, u64, u64, u64, u64) =
        fp_inv(ab0, ab1, ab2, ab3, ab4, ab5);
    // inv(a) * inv(b)
    let (inv_b0, inv_b1, inv_b2, inv_b3, inv_b4, inv_b5):
        (u64, u64, u64, u64, u64, u64) =
        fp_inv(b0, b1, b2, b3, b4, b5);
    let (prod0, prod1, prod2, prod3, prod4, prod5):
        (u64, u64, u64, u64, u64, u64) =
        fp_mul(i0, i1, i2, i3, i4, i5,
               inv_b0, inv_b1, inv_b2, inv_b3, inv_b4, inv_b5);
    assert!(fp_eq(
        inv_ab0, inv_ab1, inv_ab2, inv_ab3, inv_ab4, inv_ab5,
        prod0, prod1, prod2, prod3, prod4, prod5
    ));
    // Also verify against precomputed value
    assert!(fp_eq(
        inv_ab0, inv_ab1, inv_ab2, inv_ab3, inv_ab4, inv_ab5,
        0x67293c972020da1d, 0x66781a8ca1d61b7d,
        0x28bb960b429fdc66, 0xbe3424615318597c,
        0xbc3b3378b5df70e9, 0x1853dfc0d73c67af
    ));
}

