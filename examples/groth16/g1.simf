/*
 * BLS12-381 G1 POINT ARITHMETIC
 *
 * Curve: y^2 = x^3 + 4 over Fp
 * Jacobian projective coordinates: affine (x,y) = (X/Z^2, Y/Z^3)
 * All field elements in Montgomery form throughout.
 *
 * Phase 2 of Groth16 ZK proof verifier for SimplicityHL.
 */


// Fp arithmetic via BLS12-381 jets
fn fm(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_multiply(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fa(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_add(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fs(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let ((r0, r1), ((r2, r3), (r4, r5))): ((u64, u64), ((u64, u64), (u64, u64))) = jet::bls12_381_fp_subtract(((a0, a1), ((a2, a3), (a4, a5))), ((b0, b1), ((b2, b3), (b4, b5)))); (r0, r1, r2, r3, r4, r5) }
fn fp_to_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 0xf4df1f341c341746, 0x0a76e6a609d104f1, 0x8de5476c4c95b6d5, 0x67eb88a9939d83c0, 0x9a793e85b519952d, 0x11988fe592cae3aa) }
fn fp_from_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 1, 0, 0, 0, 0, 0) }
fn fp_eq(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool { match jet::eq_64(a0, b0) { false => false, true => match jet::eq_64(a1, b1) { false => false, true => match jet::eq_64(a2, b2) { false => false, true => match jet::eq_64(a3, b3) { false => false, true => match jet::eq_64(a4, b4) { false => false, true => jet::eq_64(a5, b5), }, }, }, }, } }
fn m(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5) }
fn a(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { fa(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5) }
fn s(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { fs(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5) }

// ============================================================
// G1 point doubling in Jacobian projective (a=0)
// Input/output: (X, Y, Z) all in Montgomery form
//
// A = X^2, B = Y^2, C = B^2
// D = 2*((X+B)^2 - A - C)
// E = 3*A
// F = E^2
// X3 = F - 2*D
// Y3 = E*(D - X3) - 8*C
// Z3 = 2*Y*Z
// ============================================================

fn g1_double(
    x0: u64, x1: u64, x2: u64, x3: u64, x4: u64, x5: u64,
    y0: u64, y1: u64, y2: u64, y3: u64, y4: u64, y5: u64,
    z0: u64, z1: u64, z2: u64, z3: u64, z4: u64, z5: u64
) -> (u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64) {
    // A = X^2
    let (a0, a1, a2, a3, a4, a5): (u64, u64, u64, u64, u64, u64) =
        m(x0, x1, x2, x3, x4, x5, x0, x1, x2, x3, x4, x5);
    // B = Y^2
    let (b0, b1, b2, b3, b4, b5): (u64, u64, u64, u64, u64, u64) =
        m(y0, y1, y2, y3, y4, y5, y0, y1, y2, y3, y4, y5);
    // C = B^2
    let (c0, c1, c2, c3, c4, c5): (u64, u64, u64, u64, u64, u64) =
        m(b0, b1, b2, b3, b4, b5, b0, b1, b2, b3, b4, b5);
    // X+B
    let (xb0, xb1, xb2, xb3, xb4, xb5): (u64, u64, u64, u64, u64, u64) =
        a(x0, x1, x2, x3, x4, x5, b0, b1, b2, b3, b4, b5);
    // (X+B)^2
    let (xb2_0, xb2_1, xb2_2, xb2_3, xb2_4, xb2_5): (u64, u64, u64, u64, u64, u64) =
        m(xb0, xb1, xb2, xb3, xb4, xb5, xb0, xb1, xb2, xb3, xb4, xb5);
    // (X+B)^2 - A - C
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) =
        s(xb2_0, xb2_1, xb2_2, xb2_3, xb2_4, xb2_5,
          a0, a1, a2, a3, a4, a5);
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) =
        s(t0, t1, t2, t3, t4, t5, c0, c1, c2, c3, c4, c5);
    // D = 2 * t
    let (d0, d1, d2, d3, d4, d5): (u64, u64, u64, u64, u64, u64) =
        a(t0, t1, t2, t3, t4, t5, t0, t1, t2, t3, t4, t5);
    // E = 3*A = A + A + A
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) =
        a(a0, a1, a2, a3, a4, a5, a0, a1, a2, a3, a4, a5);
    let (e0, e1, e2, e3, e4, e5): (u64, u64, u64, u64, u64, u64) =
        a(e0, e1, e2, e3, e4, e5, a0, a1, a2, a3, a4, a5);
    // F = E^2
    let (f0, f1, f2, f3, f4, f5): (u64, u64, u64, u64, u64, u64) =
        m(e0, e1, e2, e3, e4, e5, e0, e1, e2, e3, e4, e5);
    // X3 = F - 2*D
    let (d2_0, d2_1, d2_2, d2_3, d2_4, d2_5): (u64, u64, u64, u64, u64, u64) =
        a(d0, d1, d2, d3, d4, d5, d0, d1, d2, d3, d4, d5);
    let (rx0, rx1, rx2, rx3, rx4, rx5): (u64, u64, u64, u64, u64, u64) =
        s(f0, f1, f2, f3, f4, f5, d2_0, d2_1, d2_2, d2_3, d2_4, d2_5);
    // Y3 = E*(D - X3) - 8*C
    let (dx0, dx1, dx2, dx3, dx4, dx5): (u64, u64, u64, u64, u64, u64) =
        s(d0, d1, d2, d3, d4, d5, rx0, rx1, rx2, rx3, rx4, rx5);
    let (edx0, edx1, edx2, edx3, edx4, edx5): (u64, u64, u64, u64, u64, u64) =
        m(e0, e1, e2, e3, e4, e5, dx0, dx1, dx2, dx3, dx4, dx5);
    // 8*C = 2*(2*(2*C))
    let (c2_0, c2_1, c2_2, c2_3, c2_4, c2_5): (u64, u64, u64, u64, u64, u64) =
        a(c0, c1, c2, c3, c4, c5, c0, c1, c2, c3, c4, c5);
    let (c4_0, c4_1, c4_2, c4_3, c4_4, c4_5): (u64, u64, u64, u64, u64, u64) =
        a(c2_0, c2_1, c2_2, c2_3, c2_4, c2_5,
          c2_0, c2_1, c2_2, c2_3, c2_4, c2_5);
    let (c8_0, c8_1, c8_2, c8_3, c8_4, c8_5): (u64, u64, u64, u64, u64, u64) =
        a(c4_0, c4_1, c4_2, c4_3, c4_4, c4_5,
          c4_0, c4_1, c4_2, c4_3, c4_4, c4_5);
    let (ry0, ry1, ry2, ry3, ry4, ry5): (u64, u64, u64, u64, u64, u64) =
        s(edx0, edx1, edx2, edx3, edx4, edx5,
          c8_0, c8_1, c8_2, c8_3, c8_4, c8_5);
    // Z3 = 2*Y*Z
    let (yz0, yz1, yz2, yz3, yz4, yz5): (u64, u64, u64, u64, u64, u64) =
        m(y0, y1, y2, y3, y4, y5, z0, z1, z2, z3, z4, z5);
    let (rz0, rz1, rz2, rz3, rz4, rz5): (u64, u64, u64, u64, u64, u64) =
        a(yz0, yz1, yz2, yz3, yz4, yz5, yz0, yz1, yz2, yz3, yz4, yz5);
    (rx0, rx1, rx2, rx3, rx4, rx5,
     ry0, ry1, ry2, ry3, ry4, ry5,
     rz0, rz1, rz2, rz3, rz4, rz5)
}

// ============================================================
// G1 point addition in Jacobian projective
// (X1,Y1,Z1) + (X2,Y2,Z2)
//
// U1 = X1*Z2^2, U2 = X2*Z1^2
// S1 = Y1*Z2^3, S2 = Y2*Z1^3
// H = U2-U1, R = S2-S1
// X3 = R^2 - H^3 - 2*U1*H^2
// Y3 = R*(U1*H^2 - X3) - S1*H^3
// Z3 = H*Z1*Z2
// ============================================================

fn g1_add(
    x1_0: u64, x1_1: u64, x1_2: u64, x1_3: u64, x1_4: u64, x1_5: u64,
    y1_0: u64, y1_1: u64, y1_2: u64, y1_3: u64, y1_4: u64, y1_5: u64,
    z1_0: u64, z1_1: u64, z1_2: u64, z1_3: u64, z1_4: u64, z1_5: u64,
    x2_0: u64, x2_1: u64, x2_2: u64, x2_3: u64, x2_4: u64, x2_5: u64,
    y2_0: u64, y2_1: u64, y2_2: u64, y2_3: u64, y2_4: u64, y2_5: u64,
    z2_0: u64, z2_1: u64, z2_2: u64, z2_3: u64, z2_4: u64, z2_5: u64
) -> (u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64) {
    // Z1^2, Z2^2
    let (z1s0, z1s1, z1s2, z1s3, z1s4, z1s5): (u64, u64, u64, u64, u64, u64) =
        m(z1_0, z1_1, z1_2, z1_3, z1_4, z1_5,
          z1_0, z1_1, z1_2, z1_3, z1_4, z1_5);
    let (z2s0, z2s1, z2s2, z2s3, z2s4, z2s5): (u64, u64, u64, u64, u64, u64) =
        m(z2_0, z2_1, z2_2, z2_3, z2_4, z2_5,
          z2_0, z2_1, z2_2, z2_3, z2_4, z2_5);
    // U1 = X1*Z2^2, U2 = X2*Z1^2
    let (u1_0, u1_1, u1_2, u1_3, u1_4, u1_5): (u64, u64, u64, u64, u64, u64) =
        m(x1_0, x1_1, x1_2, x1_3, x1_4, x1_5,
          z2s0, z2s1, z2s2, z2s3, z2s4, z2s5);
    let (u2_0, u2_1, u2_2, u2_3, u2_4, u2_5): (u64, u64, u64, u64, u64, u64) =
        m(x2_0, x2_1, x2_2, x2_3, x2_4, x2_5,
          z1s0, z1s1, z1s2, z1s3, z1s4, z1s5);
    // S1 = Y1*Z2^3, S2 = Y2*Z1^3
    let (s1_0, s1_1, s1_2, s1_3, s1_4, s1_5): (u64, u64, u64, u64, u64, u64) =
        m(y1_0, y1_1, y1_2, y1_3, y1_4, y1_5,
          z2s0, z2s1, z2s2, z2s3, z2s4, z2s5);
    let (s1_0, s1_1, s1_2, s1_3, s1_4, s1_5): (u64, u64, u64, u64, u64, u64) =
        m(s1_0, s1_1, s1_2, s1_3, s1_4, s1_5,
          z2_0, z2_1, z2_2, z2_3, z2_4, z2_5);
    let (s2_0, s2_1, s2_2, s2_3, s2_4, s2_5): (u64, u64, u64, u64, u64, u64) =
        m(y2_0, y2_1, y2_2, y2_3, y2_4, y2_5,
          z1s0, z1s1, z1s2, z1s3, z1s4, z1s5);
    let (s2_0, s2_1, s2_2, s2_3, s2_4, s2_5): (u64, u64, u64, u64, u64, u64) =
        m(s2_0, s2_1, s2_2, s2_3, s2_4, s2_5,
          z1_0, z1_1, z1_2, z1_3, z1_4, z1_5);
    // H = U2 - U1
    let (h0, h1, h2, h3, h4, h5): (u64, u64, u64, u64, u64, u64) =
        s(u2_0, u2_1, u2_2, u2_3, u2_4, u2_5,
          u1_0, u1_1, u1_2, u1_3, u1_4, u1_5);
    // R = S2 - S1
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) =
        s(s2_0, s2_1, s2_2, s2_3, s2_4, s2_5,
          s1_0, s1_1, s1_2, s1_3, s1_4, s1_5);
    // H^2, H^3
    let (hs0, hs1, hs2, hs3, hs4, hs5): (u64, u64, u64, u64, u64, u64) =
        m(h0, h1, h2, h3, h4, h5, h0, h1, h2, h3, h4, h5);
    let (hc0, hc1, hc2, hc3, hc4, hc5): (u64, u64, u64, u64, u64, u64) =
        m(hs0, hs1, hs2, hs3, hs4, hs5, h0, h1, h2, h3, h4, h5);
    // U1*H^2
    let (u1h0, u1h1, u1h2, u1h3, u1h4, u1h5): (u64, u64, u64, u64, u64, u64) =
        m(u1_0, u1_1, u1_2, u1_3, u1_4, u1_5,
          hs0, hs1, hs2, hs3, hs4, hs5);
    // R^2
    let (rs0, rs1, rs2, rs3, rs4, rs5): (u64, u64, u64, u64, u64, u64) =
        m(r0, r1, r2, r3, r4, r5, r0, r1, r2, r3, r4, r5);
    // X3 = R^2 - H^3 - 2*U1*H^2
    let (rx0, rx1, rx2, rx3, rx4, rx5): (u64, u64, u64, u64, u64, u64) =
        s(rs0, rs1, rs2, rs3, rs4, rs5, hc0, hc1, hc2, hc3, hc4, hc5);
    let (u1h2_0, u1h2_1, u1h2_2, u1h2_3, u1h2_4, u1h2_5):
        (u64, u64, u64, u64, u64, u64) =
        a(u1h0, u1h1, u1h2, u1h3, u1h4, u1h5,
          u1h0, u1h1, u1h2, u1h3, u1h4, u1h5);
    let (rx0, rx1, rx2, rx3, rx4, rx5): (u64, u64, u64, u64, u64, u64) =
        s(rx0, rx1, rx2, rx3, rx4, rx5,
          u1h2_0, u1h2_1, u1h2_2, u1h2_3, u1h2_4, u1h2_5);
    // Y3 = R*(U1*H^2 - X3) - S1*H^3
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) =
        s(u1h0, u1h1, u1h2, u1h3, u1h4, u1h5,
          rx0, rx1, rx2, rx3, rx4, rx5);
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) =
        m(r0, r1, r2, r3, r4, r5, t0, t1, t2, t3, t4, t5);
    let (s1h0, s1h1, s1h2, s1h3, s1h4, s1h5): (u64, u64, u64, u64, u64, u64) =
        m(s1_0, s1_1, s1_2, s1_3, s1_4, s1_5,
          hc0, hc1, hc2, hc3, hc4, hc5);
    let (ry0, ry1, ry2, ry3, ry4, ry5): (u64, u64, u64, u64, u64, u64) =
        s(t0, t1, t2, t3, t4, t5, s1h0, s1h1, s1h2, s1h3, s1h4, s1h5);
    // Z3 = H*Z1*Z2
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) =
        m(z1_0, z1_1, z1_2, z1_3, z1_4, z1_5,
          z2_0, z2_1, z2_2, z2_3, z2_4, z2_5);
    let (rz0, rz1, rz2, rz3, rz4, rz5): (u64, u64, u64, u64, u64, u64) =
        m(h0, h1, h2, h3, h4, h5, t0, t1, t2, t3, t4, t5);
    (rx0, rx1, rx2, rx3, rx4, rx5,
     ry0, ry1, ry2, ry3, ry4, ry5,
     rz0, rz1, rz2, rz3, rz4, rz5)
}

fn main() {
    // G1 generator in Montgomery form
    let gx0: u64 = 0x5cb38790fd530c16;
    let gx1: u64 = 0x7817fc679976fff5;
    let gx2: u64 = 0x154f95c7143ba1c1;
    let gx3: u64 = 0xf0ae6acdf3d0e747;
    let gx4: u64 = 0xedce6ecc21dbf440;
    let gx5: u64 = 0x120177419e0bfb75;
    let gy0: u64 = 0xbaac93d50ce72271;
    let gy1: u64 = 0x8c22631a7918fd8e;
    let gy2: u64 = 0xdd595f13570725ce;
    let gy3: u64 = 0x51ac582950405194;
    let gy4: u64 = 0x0e1c8c3fad0059c0;
    let gy5: u64 = 0x0bbc3efc5008a26a;
    // Z = 1 in Montgomery form = R mod p
    let gz0: u64 = 0x760900000002fffd;
    let gz1: u64 = 0xebf4000bc40c0002;
    let gz2: u64 = 0x5f48985753c758ba;
    let gz3: u64 = 0x77ce585370525745;
    let gz4: u64 = 0x5c071a97a256ec6d;
    let gz5: u64 = 0x15f65ec3fa80e493;

    // Test 1: Point doubling 2*G1
    let (rx0, rx1, rx2, rx3, rx4, rx5,
         ry0, ry1, ry2, ry3, ry4, ry5,
         rz0, rz1, rz2, rz3, rz4, rz5):
        (u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64) =
        g1_double(gx0, gx1, gx2, gx3, gx4, gx5,
                  gy0, gy1, gy2, gy3, gy4, gy5,
                  gz0, gz1, gz2, gz3, gz4, gz5);

    // Verify against precomputed 2*G1 in Montgomery form
    assert!(fp_eq(
        rx0, rx1, rx2, rx3, rx4, rx5,
        0x103e61f4bdda902b, 0xdc1be65000d769d2,
        0x33ad17c51ad0c653, 0xdf15559d79828ecd,
        0xe280d22f17bc05ba, 0x0ce377ca1af03fa7
    ));
    assert!(fp_eq(
        ry0, ry1, ry2, ry3, ry4, ry5,
        0x111405902b1882bf, 0xa8cd3dd3a683ef06,
        0x13639d9f8c73cebe, 0x3ac292fd4559e0f7,
        0x628c04a2e7fb8e20, 0x15c2f5f94df1f750
    ));
    assert!(fp_eq(
        rz0, rz1, rz2, rz3, rz4, rz5,
        0x755927aa19ce44e2, 0x1844c634f231fb1d,
        0xbab2be26ae0e4b9d, 0xa358b052a080a329,
        0x1c39187f5a00b380, 0x17787df8a01144d4
    ));

    // 2*G is now (rx, ry, rz) — save for addition test
    let dx0: u64 = rx0; let dx1: u64 = rx1; let dx2: u64 = rx2;
    let dx3: u64 = rx3; let dx4: u64 = rx4; let dx5: u64 = rx5;
    let dy0: u64 = ry0; let dy1: u64 = ry1; let dy2: u64 = ry2;
    let dy3: u64 = ry3; let dy4: u64 = ry4; let dy5: u64 = ry5;
    let dz0: u64 = rz0; let dz1: u64 = rz1; let dz2: u64 = rz2;
    let dz3: u64 = rz3; let dz4: u64 = rz4; let dz5: u64 = rz5;

    // Test 2: Point addition 3*G = 2*G + G
    let (rx0, rx1, rx2, rx3, rx4, rx5,
         ry0, ry1, ry2, ry3, ry4, ry5,
         rz0, rz1, rz2, rz3, rz4, rz5):
        (u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64) =
        g1_add(dx0, dx1, dx2, dx3, dx4, dx5,
               dy0, dy1, dy2, dy3, dy4, dy5,
               dz0, dz1, dz2, dz3, dz4, dz5,
               gx0, gx1, gx2, gx3, gx4, gx5,
               gy0, gy1, gy2, gy3, gy4, gy5,
               gz0, gz1, gz2, gz3, gz4, gz5);
    // Verify 3*G against precomputed Montgomery values
    assert!(fp_eq(
        rx0, rx1, rx2, rx3, rx4, rx5,
        0x740d6a16fa3a0d3b, 0xaa1c443eb792c2a2,
        0x1c9f991f4e00fa9d, 0xf3b851b5b80e374a,
        0x65d67f787f5d664d, 0x09799eff1e1f0bf5
    ));
    assert!(fp_eq(
        ry0, ry1, ry2, ry3, ry4, ry5,
        0xb3a2a40f50b4ead8, 0x9d583925ab1cf17a,
        0x7d957c7149c0513e, 0x651e95fba71d2ebd,
        0xfd771ba251765b72, 0x13637332f595cb93
    ));
    assert!(fp_eq(
        rz0, rz1, rz2, rz3, rz4, rz5,
        0x0895fcf12bc14b0c, 0xdb5814f29c3be7e5,
        0x19d45e01df9232e8, 0xa9b08ad0a4d00b37,
        0x7053e2f56f1bf67c, 0x110b401e75589c9d
    ));

    // Test 3: 4*G via doubling: 2*(2*G)
    let (rx0, rx1, rx2, rx3, rx4, rx5,
         ry0, ry1, ry2, ry3, ry4, ry5,
         rz0, rz1, rz2, rz3, rz4, rz5):
        (u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64) =
        g1_double(dx0, dx1, dx2, dx3, dx4, dx5,
                  dy0, dy1, dy2, dy3, dy4, dy5,
                  dz0, dz1, dz2, dz3, dz4, dz5);
    assert!(fp_eq(
        rx0, rx1, rx2, rx3, rx4, rx5,
        0x54ba6c9ca8eb59dd, 0xeb816378f59ce807,
        0xdfc715299dfc4659, 0x31c1299820756eff,
        0x0e2bdfad1d5ad087, 0x019c7444aac4e884
    ));
    assert!(fp_eq(
        ry0, ry1, ry2, ry3, ry4, ry5,
        0x229817ed47e72341, 0xf58a559ed7a83100,
        0x849734c372edbeaf, 0x3a859987d772dfad,
        0x08c257a5ec646bd3, 0x030e8d491d70144a
    ));
}

