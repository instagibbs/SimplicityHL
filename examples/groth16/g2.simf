/*
 * BLS12-381 G2 POINT DOUBLING
 *
 * G2 is on the twist E'(Fp2): y^2 = x^3 + 4(1+u)
 * Same Jacobian formulas as G1 but over Fp2.
 * Each Fp2 element = (c0, c1) = c0 + c1*u, u^2 = -1.
 *
 * Phase 3b of Groth16 ZK proof verifier for SimplicityHL.
 */

// ============================================================
// Fp Montgomery primitives (compact)
// ============================================================

fn split(x: u128) -> (u64, u64) { <u128>::into(x) }

fn add6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (bool, u64, u64, u64, u64, u64, u64) {
    let (c0, r0): (bool, u64) = jet::add_64(a0, b0); let (c1, r1): (bool, u64) = jet::full_add_64(c0, a1, b1); let (c2, r2): (bool, u64) = jet::full_add_64(c1, a2, b2); let (c3, r3): (bool, u64) = jet::full_add_64(c2, a3, b3); let (c4, r4): (bool, u64) = jet::full_add_64(c3, a4, b4); let (c5, r5): (bool, u64) = jet::full_add_64(c4, a5, b5); (c5, r0, r1, r2, r3, r4, r5)
}

fn sub6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (bool, u64, u64, u64, u64, u64, u64) {
    let (w0, r0): (bool, u64) = jet::subtract_64(a0, b0); let (w1, r1): (bool, u64) = jet::full_subtract_64(w0, a1, b1); let (w2, r2): (bool, u64) = jet::full_subtract_64(w1, a2, b2); let (w3, r3): (bool, u64) = jet::full_subtract_64(w2, a3, b3); let (w4, r4): (bool, u64) = jet::full_subtract_64(w3, a4, b4); let (w5, r5): (bool, u64) = jet::full_subtract_64(w4, a5, b5); (w5, r0, r1, r2, r3, r4, r5)
}

fn fp_gte(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool {
    match jet::lt_64(a5, b5) { true => false, false => match jet::lt_64(b5, a5) { true => true, false => match jet::lt_64(a4, b4) { true => false, false => match jet::lt_64(b4, a4) { true => true, false => match jet::lt_64(a3, b3) { true => false, false => match jet::lt_64(b3, a3) { true => true, false => match jet::lt_64(a2, b2) { true => false, false => match jet::lt_64(b2, a2) { true => true, false => match jet::lt_64(a1, b1) { true => false, false => match jet::lt_64(b1, a1) { true => true, false => jet::le_64(b0, a0), }, }, }, }, }, }, }, }, }, }
}

fn fp_eq(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool {
    match jet::eq_64(a0, b0) { false => false, true => match jet::eq_64(a1, b1) { false => false, true => match jet::eq_64(a2, b2) { false => false, true => match jet::eq_64(a3, b3) { false => false, true => match jet::eq_64(a4, b4) { false => false, true => jet::eq_64(a5, b5), }, }, }, }, }
}

fn mont_limb(mm: u64, pj: u64, tj: u64, carry: u64) -> (u64, u64) {
    let (ph, pl): (u64, u64) = split(jet::multiply_64(mm, pj)); let (c1, s1): (bool, u64) = jet::add_64(pl, tj); let (c2, r): (bool, u64) = jet::add_64(s1, carry); let c1_64: u64 = jet::left_pad_low_1_64(<bool>::into(c1)); let c2_64: u64 = jet::left_pad_low_1_64(<bool>::into(c2)); let (_, nc): (bool, u64) = jet::add_64(ph, c1_64); let (_, nc): (bool, u64) = jet::add_64(nc, c2_64); (r, nc)
}

fn mround(ti: u64, t0: u64, t1: u64, t2: u64, t3: u64, t4: u64, t5: u64, tn: u64) -> (u64, u64, u64, u64, u64, u64, u64) {
    let (_, mm): (u64, u64) = split(jet::multiply_64(ti, 0x89f3fffcfffcfffd)); let (_, carry): (u64, u64) = mont_limb(mm, 0xb9feffffffffaaab, ti, 0); let (t0, carry): (u64, u64) = mont_limb(mm, 0x1eabfffeb153ffff, t0, carry); let (t1, carry): (u64, u64) = mont_limb(mm, 0x6730d2a0f6b0f624, t1, carry); let (t2, carry): (u64, u64) = mont_limb(mm, 0x64774b84f38512bf, t2, carry); let (t3, carry): (u64, u64) = mont_limb(mm, 0x4b1ba7b6434bacd7, t3, carry); let (t4, carry): (u64, u64) = mont_limb(mm, 0x1a0111ea397fe69a, t4, carry); let (_, t5): (bool, u64) = jet::add_64(tn, carry); (t0, t1, t2, t3, t4, t5, 0)
}

fn redc(t0: u64, t1: u64, t2: u64, t3: u64, t4: u64, t5: u64, t6: u64, t7: u64, t8: u64, t9: u64, t10: u64, t11: u64) -> (u64, u64, u64, u64, u64, u64) {
    let (t1, t2, t3, t4, t5, t6, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t0, t1, t2, t3, t4, t5, t6, t7); let (t2, t3, t4, t5, t6, t7, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t1, t2, t3, t4, t5, t6, t7, t8); let (t3, t4, t5, t6, t7, t8, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t2, t3, t4, t5, t6, t7, t8, t9); let (t4, t5, t6, t7, t8, t9, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t3, t4, t5, t6, t7, t8, t9, t10); let (t5, t6, t7, t8, t9, t10, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t4, t5, t6, t7, t8, t9, t10, t11); let (t6, t7, t8, t9, t10, t11, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t5, t6, t7, t8, t9, t10, t11, 0);
    let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a;
    match fp_gte(t6, t7, t8, t9, t10, t11, p0, p1, p2, p3, p4, p5) { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(t6, t7, t8, t9, t10, t11, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (t6, t7, t8, t9, t10, t11), }
}

fn acc_add(al: u64, ah: u64, ac: u64, prod: u128) -> (u64, u64, u64) { let (ph, pl): (u64, u64) = split(prod); let (c0, rl): (bool, u64) = jet::add_64(al, pl); let (c1, rh): (bool, u64) = jet::full_add_64(c0, ah, ph); let (_, rc): (bool, u64) = jet::full_add_64(c1, ac, 0); (rl, rh, rc) }
fn col0(a0: u64, b0: u64, cl: u64, ch: u64) -> (u64, u64, u64) { acc_add(cl, ch, 0, jet::multiply_64(a0, b0)) }
fn col1(a0: u64, a1: u64, b0: u64, b1: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b1)); acc_add(l, h, c, jet::multiply_64(a1, b0)) }
fn col2(a0: u64, a1: u64, a2: u64, b0: u64, b1: u64, b2: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b1)); acc_add(l, h, c, jet::multiply_64(a2, b0)) }
fn col3(a0: u64, a1: u64, a2: u64, a3: u64, b0: u64, b1: u64, b2: u64, b3: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b1)); acc_add(l, h, c, jet::multiply_64(a3, b0)) }
fn col4(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b1)); acc_add(l, h, c, jet::multiply_64(a4, b0)) }
fn col5(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b1)); acc_add(l, h, c, jet::multiply_64(a5, b0)) }
fn col6(a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a1, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b2)); acc_add(l, h, c, jet::multiply_64(a5, b1)) }
fn col7(a2: u64, a3: u64, a4: u64, a5: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a2, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b3)); acc_add(l, h, c, jet::multiply_64(a5, b2)) }
fn col8(a3: u64, a4: u64, a5: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a3, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b4)); acc_add(l, h, c, jet::multiply_64(a5, b3)) }
fn col9(a4: u64, a5: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a4, b5)); acc_add(l, h, c, jet::multiply_64(a5, b4)) }
fn col10(a5: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { acc_add(cl, ch, 0, jet::multiply_64(a5, b5)) }

fn mul6x6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    let (r0, ch, cc): (u64, u64, u64) = col0(a0, b0, 0, 0); let (r1, ch, cc): (u64, u64, u64) = col1(a0, a1, b0, b1, ch, cc); let (r2, ch, cc): (u64, u64, u64) = col2(a0, a1, a2, b0, b1, b2, ch, cc); let (r3, ch, cc): (u64, u64, u64) = col3(a0, a1, a2, a3, b0, b1, b2, b3, ch, cc); let (r4, ch, cc): (u64, u64, u64) = col4(a0, a1, a2, a3, a4, b0, b1, b2, b3, b4, ch, cc); let (r5, ch, cc): (u64, u64, u64) = col5(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5, ch, cc); let (r6, ch, cc): (u64, u64, u64) = col6(a1, a2, a3, a4, a5, b1, b2, b3, b4, b5, ch, cc); let (r7, ch, cc): (u64, u64, u64) = col7(a2, a3, a4, a5, b2, b3, b4, b5, ch, cc); let (r8, ch, cc): (u64, u64, u64) = col8(a3, a4, a5, b3, b4, b5, ch, cc); let (r9, ch, cc): (u64, u64, u64) = col9(a4, a5, b4, b5, ch, cc); let (r10, r11, _): (u64, u64, u64) = col10(a5, b5, ch, cc); (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11)
}

// Fp Montgomery mul/add/sub
fn fm(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) {
    let (t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = mul6x6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5); redc(t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11)
}

fn fa(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) {
    let (carry, r0, r1, r2, r3, r4, r5): (bool, u64, u64, u64, u64, u64, u64) = add6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a;
    match carry { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => match fp_gte(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5) { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (r0, r1, r2, r3, r4, r5), }, }
}

fn fs(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) {
    let (borrow, r0, r1, r2, r3, r4, r5): (bool, u64, u64, u64, u64, u64, u64) = sub6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a;
    match borrow { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = add6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (r0, r1, r2, r3, r4, r5), }
}

fn fp_from_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { redc(a0, a1, a2, a3, a4, a5, 0, 0, 0, 0, 0, 0) }

// ============================================================
// Fp2 = (c0, c1) where element = c0 + c1*u, u^2 = -1
// Each c is 6 x u64 Montgomery. Return 12 x u64.
// ============================================================

fn f2m(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64, a10: u64, a11: u64,
    b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64,
    b6: u64, b7: u64, b8: u64, b9: u64, b10: u64, b11: u64
) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    // (a_re + a_im*u)(b_re + b_im*u) = (a_re*b_re - a_im*b_im) + (...)u
    let (v0_0, v0_1, v0_2, v0_3, v0_4, v0_5): (u64, u64, u64, u64, u64, u64) = fm(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let (v1_0, v1_1, v1_2, v1_3, v1_4, v1_5): (u64, u64, u64, u64, u64, u64) = fm(a6, a7, a8, a9, a10, a11, b6, b7, b8, b9, b10, b11);
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fs(v0_0, v0_1, v0_2, v0_3, v0_4, v0_5, v1_0, v1_1, v1_2, v1_3, v1_4, v1_5);
    // Karatsuba: imag = (a_re+a_im)(b_re+b_im) - v0 - v1
    let (s0, s1, s2, s3, s4, s5): (u64, u64, u64, u64, u64, u64) = fa(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11);
    let (t0, t1, t2, t3, t4, t5): (u64, u64, u64, u64, u64, u64) = fa(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fm(s0, s1, s2, s3, s4, s5, t0, t1, t2, t3, t4, t5);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fs(i0, i1, i2, i3, i4, i5, v0_0, v0_1, v0_2, v0_3, v0_4, v0_5);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fs(i0, i1, i2, i3, i4, i5, v1_0, v1_1, v1_2, v1_3, v1_4, v1_5);
    (r0, r1, r2, r3, r4, r5, i0, i1, i2, i3, i4, i5)
}

fn f2a(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64, a10: u64, a11: u64,
    b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64,
    b6: u64, b7: u64, b8: u64, b9: u64, b10: u64, b11: u64
) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fa(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fa(a6, a7, a8, a9, a10, a11, b6, b7, b8, b9, b10, b11);
    (r0, r1, r2, r3, r4, r5, i0, i1, i2, i3, i4, i5)
}

fn f2s(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64, a10: u64, a11: u64,
    b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64,
    b6: u64, b7: u64, b8: u64, b9: u64, b10: u64, b11: u64
) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    let (r0, r1, r2, r3, r4, r5): (u64, u64, u64, u64, u64, u64) = fs(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5);
    let (i0, i1, i2, i3, i4, i5): (u64, u64, u64, u64, u64, u64) = fs(a6, a7, a8, a9, a10, a11, b6, b7, b8, b9, b10, b11);
    (r0, r1, r2, r3, r4, r5, i0, i1, i2, i3, i4, i5)
}

// ============================================================
// G2 point doubling over Fp2 (a=0, same formula as G1)
// Point = (X, Y, Z) where each coord is Fp2 = 12 u64
// ============================================================

fn g2_double(
    x0: u64, x1: u64, x2: u64, x3: u64, x4: u64, x5: u64, x6: u64, x7: u64, x8: u64, x9: u64, x10: u64, x11: u64,
    y0: u64, y1: u64, y2: u64, y3: u64, y4: u64, y5: u64, y6: u64, y7: u64, y8: u64, y9: u64, y10: u64, y11: u64,
    z0: u64, z1: u64, z2: u64, z3: u64, z4: u64, z5: u64, z6: u64, z7: u64, z8: u64, z9: u64, z10: u64, z11: u64
) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    // A = X^2
    let (a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11);
    // B = Y^2
    let (b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11);
    // C = B^2
    let (c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11);
    // D = 2*((X+B)^2 - A - C)
    let (xb0, xb1, xb2, xb3, xb4, xb5, xb6, xb7, xb8, xb9, xb10, xb11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11);
    let (xb0, xb1, xb2, xb3, xb4, xb5, xb6, xb7, xb8, xb9, xb10, xb11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(xb0, xb1, xb2, xb3, xb4, xb5, xb6, xb7, xb8, xb9, xb10, xb11, xb0, xb1, xb2, xb3, xb4, xb5, xb6, xb7, xb8, xb9, xb10, xb11);
    let (t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2s(xb0, xb1, xb2, xb3, xb4, xb5, xb6, xb7, xb8, xb9, xb10, xb11, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11);
    let (t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2s(t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11);
    let (d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11);
    // E = 3*A
    let (e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11);
    let (e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11);
    // F = E^2
    let (f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11);
    // X3 = F - 2D
    let (d2_0, d2_1, d2_2, d2_3, d2_4, d2_5, d2_6, d2_7, d2_8, d2_9, d2_10, d2_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11);
    let (rx0, rx1, rx2, rx3, rx4, rx5, rx6, rx7, rx8, rx9, rx10, rx11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2s(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, d2_0, d2_1, d2_2, d2_3, d2_4, d2_5, d2_6, d2_7, d2_8, d2_9, d2_10, d2_11);
    // Y3 = E*(D-X3) - 8C
    let (dx0, dx1, dx2, dx3, dx4, dx5, dx6, dx7, dx8, dx9, dx10, dx11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2s(d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, rx0, rx1, rx2, rx3, rx4, rx5, rx6, rx7, rx8, rx9, rx10, rx11);
    let (edx0, edx1, edx2, edx3, edx4, edx5, edx6, edx7, edx8, edx9, edx10, edx11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, dx0, dx1, dx2, dx3, dx4, dx5, dx6, dx7, dx8, dx9, dx10, dx11);
    let (c2_0, c2_1, c2_2, c2_3, c2_4, c2_5, c2_6, c2_7, c2_8, c2_9, c2_10, c2_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11);
    let (c4_0, c4_1, c4_2, c4_3, c4_4, c4_5, c4_6, c4_7, c4_8, c4_9, c4_10, c4_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(c2_0, c2_1, c2_2, c2_3, c2_4, c2_5, c2_6, c2_7, c2_8, c2_9, c2_10, c2_11, c2_0, c2_1, c2_2, c2_3, c2_4, c2_5, c2_6, c2_7, c2_8, c2_9, c2_10, c2_11);
    let (c8_0, c8_1, c8_2, c8_3, c8_4, c8_5, c8_6, c8_7, c8_8, c8_9, c8_10, c8_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(c4_0, c4_1, c4_2, c4_3, c4_4, c4_5, c4_6, c4_7, c4_8, c4_9, c4_10, c4_11, c4_0, c4_1, c4_2, c4_3, c4_4, c4_5, c4_6, c4_7, c4_8, c4_9, c4_10, c4_11);
    let (ry0, ry1, ry2, ry3, ry4, ry5, ry6, ry7, ry8, ry9, ry10, ry11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2s(edx0, edx1, edx2, edx3, edx4, edx5, edx6, edx7, edx8, edx9, edx10, edx11, c8_0, c8_1, c8_2, c8_3, c8_4, c8_5, c8_6, c8_7, c8_8, c8_9, c8_10, c8_11);
    // Z3 = 2*Y*Z
    let (yz0, yz1, yz2, yz3, yz4, yz5, yz6, yz7, yz8, yz9, yz10, yz11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11);
    let (rz0, rz1, rz2, rz3, rz4, rz5, rz6, rz7, rz8, rz9, rz10, rz11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2a(yz0, yz1, yz2, yz3, yz4, yz5, yz6, yz7, yz8, yz9, yz10, yz11, yz0, yz1, yz2, yz3, yz4, yz5, yz6, yz7, yz8, yz9, yz10, yz11);
    (rx0, rx1, rx2, rx3, rx4, rx5, rx6, rx7, rx8, rx9, rx10, rx11,
     ry0, ry1, ry2, ry3, ry4, ry5, ry6, ry7, ry8, ry9, ry10, ry11,
     rz0, rz1, rz2, rz3, rz4, rz5, rz6, rz7, rz8, rz9, rz10, rz11)
}

