/*
 * BLS12-381 GROTH16 VERIFIER
 *
 * Multi-Miller loop + final exponentiation for 4-pairing check:
 * e(A, B) * e(-alpha, beta) * e(-vk_x, gamma) * e(-C, delta) == 1
 */

fn split(x: u128) -> (u64, u64) { <u128>::into(x) }
fn add6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (bool, u64, u64, u64, u64, u64, u64) { let (c0, r0): (bool, u64) = jet::add_64(a0, b0); let (c1, r1): (bool, u64) = jet::full_add_64(c0, a1, b1); let (c2, r2): (bool, u64) = jet::full_add_64(c1, a2, b2); let (c3, r3): (bool, u64) = jet::full_add_64(c2, a3, b3); let (c4, r4): (bool, u64) = jet::full_add_64(c3, a4, b4); let (c5, r5): (bool, u64) = jet::full_add_64(c4, a5, b5); (c5, r0, r1, r2, r3, r4, r5) }
fn sub6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (bool, u64, u64, u64, u64, u64, u64) { let (w0, r0): (bool, u64) = jet::subtract_64(a0, b0); let (w1, r1): (bool, u64) = jet::full_subtract_64(w0, a1, b1); let (w2, r2): (bool, u64) = jet::full_subtract_64(w1, a2, b2); let (w3, r3): (bool, u64) = jet::full_subtract_64(w2, a3, b3); let (w4, r4): (bool, u64) = jet::full_subtract_64(w3, a4, b4); let (w5, r5): (bool, u64) = jet::full_subtract_64(w4, a5, b5); (w5, r0, r1, r2, r3, r4, r5) }
fn fp_gte(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool { match jet::lt_64(a5, b5) { true => false, false => match jet::lt_64(b5, a5) { true => true, false => match jet::lt_64(a4, b4) { true => false, false => match jet::lt_64(b4, a4) { true => true, false => match jet::lt_64(a3, b3) { true => false, false => match jet::lt_64(b3, a3) { true => true, false => match jet::lt_64(a2, b2) { true => false, false => match jet::lt_64(b2, a2) { true => true, false => match jet::lt_64(a1, b1) { true => false, false => match jet::lt_64(b1, a1) { true => true, false => jet::le_64(b0, a0), }, }, }, }, }, }, }, }, }, } }
fn fp_eq(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> bool { match jet::eq_64(a0, b0) { false => false, true => match jet::eq_64(a1, b1) { false => false, true => match jet::eq_64(a2, b2) { false => false, true => match jet::eq_64(a3, b3) { false => false, true => match jet::eq_64(a4, b4) { false => false, true => jet::eq_64(a5, b5), }, }, }, }, } }
fn mont_limb(mm: u64, pj: u64, tj: u64, carry: u64) -> (u64, u64) { let (ph, pl): (u64, u64) = split(jet::multiply_64(mm, pj)); let (c1, s1): (bool, u64) = jet::add_64(pl, tj); let (c2, r): (bool, u64) = jet::add_64(s1, carry); let c1_64: u64 = jet::left_pad_low_1_64(<bool>::into(c1)); let c2_64: u64 = jet::left_pad_low_1_64(<bool>::into(c2)); let (_, nc): (bool, u64) = jet::add_64(ph, c1_64); let (_, nc): (bool, u64) = jet::add_64(nc, c2_64); (r, nc) }
fn mround(ti: u64, t0: u64, t1: u64, t2: u64, t3: u64, t4: u64, t5: u64, tn: u64) -> (u64, u64, u64, u64, u64, u64, u64) { let (_, mm): (u64, u64) = split(jet::multiply_64(ti, 0x89f3fffcfffcfffd)); let (_, carry): (u64, u64) = mont_limb(mm, 0xb9feffffffffaaab, ti, 0); let (t0, carry): (u64, u64) = mont_limb(mm, 0x1eabfffeb153ffff, t0, carry); let (t1, carry): (u64, u64) = mont_limb(mm, 0x6730d2a0f6b0f624, t1, carry); let (t2, carry): (u64, u64) = mont_limb(mm, 0x64774b84f38512bf, t2, carry); let (t3, carry): (u64, u64) = mont_limb(mm, 0x4b1ba7b6434bacd7, t3, carry); let (t4, carry): (u64, u64) = mont_limb(mm, 0x1a0111ea397fe69a, t4, carry); let (c5, t5): (bool, u64) = jet::add_64(t5, carry); let c5_64: u64 = jet::left_pad_low_1_64(<bool>::into(c5)); let (_, t6): (bool, u64) = jet::add_64(tn, c5_64); (t0, t1, t2, t3, t4, t5, t6) }
fn redc(t0: u64, t1: u64, t2: u64, t3: u64, t4: u64, t5: u64, t6: u64, t7: u64, t8: u64, t9: u64, t10: u64, t11: u64) -> (u64, u64, u64, u64, u64, u64) { let (t1, t2, t3, t4, t5, t6, t7): (u64, u64, u64, u64, u64, u64, u64) = mround(t0, t1, t2, t3, t4, t5, t6, t7); let (t2, t3, t4, t5, t6, t7, t8): (u64, u64, u64, u64, u64, u64, u64) = mround(t1, t2, t3, t4, t5, t6, t7, t8); let (t3, t4, t5, t6, t7, t8, t9): (u64, u64, u64, u64, u64, u64, u64) = mround(t2, t3, t4, t5, t6, t7, t8, t9); let (t4, t5, t6, t7, t8, t9, t10): (u64, u64, u64, u64, u64, u64, u64) = mround(t3, t4, t5, t6, t7, t8, t9, t10); let (t5, t6, t7, t8, t9, t10, t11): (u64, u64, u64, u64, u64, u64, u64) = mround(t4, t5, t6, t7, t8, t9, t10, t11); let (t6, t7, t8, t9, t10, t11, _): (u64, u64, u64, u64, u64, u64, u64) = mround(t5, t6, t7, t8, t9, t10, t11, 0); let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a; match fp_gte(t6, t7, t8, t9, t10, t11, p0, p1, p2, p3, p4, p5) { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(t6, t7, t8, t9, t10, t11, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (t6, t7, t8, t9, t10, t11), } }
fn acc_add(al: u64, ah: u64, ac: u64, prod: u128) -> (u64, u64, u64) { let (ph, pl): (u64, u64) = split(prod); let (c0, rl): (bool, u64) = jet::add_64(al, pl); let (c1, rh): (bool, u64) = jet::full_add_64(c0, ah, ph); let (_, rc): (bool, u64) = jet::full_add_64(c1, ac, 0); (rl, rh, rc) }
fn col0(a0: u64, b0: u64, cl: u64, ch: u64) -> (u64, u64, u64) { acc_add(cl, ch, 0, jet::multiply_64(a0, b0)) }
fn col1(a0: u64, a1: u64, b0: u64, b1: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b1)); acc_add(l, h, c, jet::multiply_64(a1, b0)) }
fn col2(a0: u64, a1: u64, a2: u64, b0: u64, b1: u64, b2: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b1)); acc_add(l, h, c, jet::multiply_64(a2, b0)) }
fn col3(a0: u64, a1: u64, a2: u64, a3: u64, b0: u64, b1: u64, b2: u64, b3: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b1)); acc_add(l, h, c, jet::multiply_64(a3, b0)) }
fn col4(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b1)); acc_add(l, h, c, jet::multiply_64(a4, b0)) }
fn col5(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a0, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a1, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b2)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b1)); acc_add(l, h, c, jet::multiply_64(a5, b0)) }
fn col6(a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a1, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a2, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b3)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b2)); acc_add(l, h, c, jet::multiply_64(a5, b1)) }
fn col7(a2: u64, a3: u64, a4: u64, a5: u64, b2: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a2, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a3, b4)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b3)); acc_add(l, h, c, jet::multiply_64(a5, b2)) }
fn col8(a3: u64, a4: u64, a5: u64, b3: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a3, b5)); let (l, h, c): (u64, u64, u64) = acc_add(l, h, c, jet::multiply_64(a4, b4)); acc_add(l, h, c, jet::multiply_64(a5, b3)) }
fn col9(a4: u64, a5: u64, b4: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { let (l, h, c): (u64, u64, u64) = acc_add(cl, ch, 0, jet::multiply_64(a4, b5)); acc_add(l, h, c, jet::multiply_64(a5, b4)) }
fn col10(a5: u64, b5: u64, cl: u64, ch: u64) -> (u64, u64, u64) { acc_add(cl, ch, 0, jet::multiply_64(a5, b5)) }
fn mul6x6(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) { let (r0, ch, cc): (u64, u64, u64) = col0(a0, b0, 0, 0); let (r1, ch, cc): (u64, u64, u64) = col1(a0, a1, b0, b1, ch, cc); let (r2, ch, cc): (u64, u64, u64) = col2(a0, a1, a2, b0, b1, b2, ch, cc); let (r3, ch, cc): (u64, u64, u64) = col3(a0, a1, a2, a3, b0, b1, b2, b3, ch, cc); let (r4, ch, cc): (u64, u64, u64) = col4(a0, a1, a2, a3, a4, b0, b1, b2, b3, b4, ch, cc); let (r5, ch, cc): (u64, u64, u64) = col5(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5, ch, cc); let (r6, ch, cc): (u64, u64, u64) = col6(a1, a2, a3, a4, a5, b1, b2, b3, b4, b5, ch, cc); let (r7, ch, cc): (u64, u64, u64) = col7(a2, a3, a4, a5, b2, b3, b4, b5, ch, cc); let (r8, ch, cc): (u64, u64, u64) = col8(a3, a4, a5, b3, b4, b5, ch, cc); let (r9, ch, cc): (u64, u64, u64) = col9(a4, a5, b4, b5, ch, cc); let (r10, r11, _): (u64, u64, u64) = col10(a5, b5, ch, cc); (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11) }
fn fm(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let (t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = mul6x6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5); redc(t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11) }
fn fa(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let (carry, r0, r1, r2, r3, r4, r5): (bool, u64, u64, u64, u64, u64, u64) = add6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5); let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a; match carry { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => match fp_gte(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5) { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = sub6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (r0, r1, r2, r3, r4, r5), }, } }
fn fs(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, b0: u64, b1: u64, b2: u64, b3: u64, b4: u64, b5: u64) -> (u64, u64, u64, u64, u64, u64) { let (borrow, r0, r1, r2, r3, r4, r5): (bool, u64, u64, u64, u64, u64, u64) = sub6(a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5); let p0: u64 = 0xb9feffffffffaaab; let p1: u64 = 0x1eabfffeb153ffff; let p2: u64 = 0x6730d2a0f6b0f624; let p3: u64 = 0x64774b84f38512bf; let p4: u64 = 0x4b1ba7b6434bacd7; let p5: u64 = 0x1a0111ea397fe69a; match borrow { true => { let (_, s0, s1, s2, s3, s4, s5): (bool, u64, u64, u64, u64, u64, u64) = add6(r0, r1, r2, r3, r4, r5, p0, p1, p2, p3, p4, p5); (s0, s1, s2, s3, s4, s5) }, false => (r0, r1, r2, r3, r4, r5), } }
fn fp_to_mont(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u64, u64, u64, u64, u64, u64) { fm(a0, a1, a2, a3, a4, a5, 0xf4df1f341c341746, 0x0a76e6a609d104f1, 0x8de5476c4c95b6d5, 0x67eb88a9939d83c0, 0x9a793e85b519952d, 0x11988fe592cae3aa) }
