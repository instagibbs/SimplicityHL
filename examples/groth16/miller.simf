// ============================================================

fn line_double(
    // R coords: X_re, X_im, Y_re, Y_im, Z_re, Z_im (each 6 u64)
    xr0: u64, xr1: u64, xr2: u64, xr3: u64, xr4: u64, xr5: u64,
    xr6: u64, xr7: u64, xr8: u64, xr9: u64, xr10: u64, xr11: u64,
    yr0: u64, yr1: u64, yr2: u64, yr3: u64, yr4: u64, yr5: u64,
    yr6: u64, yr7: u64, yr8: u64, yr9: u64, yr10: u64, yr11: u64,
    zr0: u64, zr1: u64, zr2: u64, zr3: u64, zr4: u64, zr5: u64,
    zr6: u64, zr7: u64, zr8: u64, zr9: u64, zr10: u64, zr11: u64,
    // P coords: xP, yP (each 6 u64 Montgomery)
    px0: u64, px1: u64, px2: u64, px3: u64, px4: u64, px5: u64,
    py0: u64, py1: u64, py2: u64, py3: u64, py4: u64, py5: u64
) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    // Apply twist isomorphism: (a, b) -> (a-b, b)
    let (tw_xr0, tw_xr1, tw_xr2, tw_xr3, tw_xr4, tw_xr5): (u64, u64, u64, u64, u64, u64) = fs(xr0, xr1, xr2, xr3, xr4, xr5, xr6, xr7, xr8, xr9, xr10, xr11);
    let (tw_xi0, tw_xi1, tw_xi2, tw_xi3, tw_xi4, tw_xi5): (u64, u64, u64, u64, u64, u64) = (xr6, xr7, xr8, xr9, xr10, xr11);
    let (tw_yr0, tw_yr1, tw_yr2, tw_yr3, tw_yr4, tw_yr5): (u64, u64, u64, u64, u64, u64) = fs(yr0, yr1, yr2, yr3, yr4, yr5, yr6, yr7, yr8, yr9, yr10, yr11);
    let (tw_yi0, tw_yi1, tw_yi2, tw_yi3, tw_yi4, tw_yi5): (u64, u64, u64, u64, u64, u64) = (yr6, yr7, yr8, yr9, yr10, yr11);
    let (tw_zr0, tw_zr1, tw_zr2, tw_zr3, tw_zr4, tw_zr5): (u64, u64, u64, u64, u64, u64) = fs(zr0, zr1, zr2, zr3, zr4, zr5, zr6, zr7, zr8, zr9, zr10, zr11);
    let (tw_zi0, tw_zi1, tw_zi2, tw_zi3, tw_zi4, tw_zi5): (u64, u64, u64, u64, u64, u64) = (zr6, zr7, zr8, zr9, zr10, zr11);
    let z: u64 = 0;
    // Montgomery one
    let one0: u64 = 0x760900000002fffd; let one1: u64 = 0xebf4000bc40c0002;
    let one2: u64 = 0x5f48985753c758ba; let one3: u64 = 0x77ce585370525745;
    let one4: u64 = 0x5c071a97a256ec6d; let one5: u64 = 0x15f65ec3fa80e493;
    // Montgomery 3
    let (two0, two1, two2, two3, two4, two5): (u64, u64, u64, u64, u64, u64) = fa(one0, one1, one2, one3, one4, one5, one0, one1, one2, one3, one4, one5);
    let (three0, three1, three2, three3, three4, three5): (u64, u64, u64, u64, u64, u64) = fa(two0, two1, two2, two3, two4, two5, one0, one1, one2, one3, one4, one5);
    // x1^2 (Fp12: sparse at c1) -> Fp12 sparse at c2 = tw_x^2
    let (x1sq_r0, x1sq_r1, x1sq_r2, x1sq_r3, x1sq_r4, x1sq_r5, x1sq_i0, x1sq_i1, x1sq_i2, x1sq_i3, x1sq_i4, x1sq_i5): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(tw_xr0, tw_xr1, tw_xr2, tw_xr3, tw_xr4, tw_xr5, tw_xi0, tw_xi1, tw_xi2, tw_xi3, tw_xi4, tw_xi5, tw_xr0, tw_xr1, tw_xr2, tw_xr3, tw_xr4, tw_xr5, tw_xi0, tw_xi1, tw_xi2, tw_xi3, tw_xi4, tw_xi5);
    // m_num c2 = 3 * x1sq (scale each Fp by 3)
