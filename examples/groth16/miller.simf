        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_sub(
            t1_0, t1_1, t1_2, t1_3, t1_4, t1_5, t1_6, t1_7, t1_8, t1_9, t1_10, t1_11, t1_12, t1_13, t1_14, t1_15, t1_16, t1_17, t1_18, t1_19, t1_20, t1_21, t1_22, t1_23, t1_24, t1_25, t1_26, t1_27, t1_28, t1_29, t1_30, t1_31, t1_32, t1_33, t1_34, t1_35, t1_36, t1_37, t1_38, t1_39, t1_40, t1_41, t1_42, t1_43, t1_44, t1_45, t1_46, t1_47, t1_48, t1_49, t1_50, t1_51, t1_52, t1_53, t1_54, t1_55, t1_56, t1_57, t1_58, t1_59, t1_60, t1_61, t1_62, t1_63, t1_64, t1_65, t1_66, t1_67, t1_68, t1_69, t1_70, t1_71,
            t2_0, t2_1, t2_2, t2_3, t2_4, t2_5, t2_6, t2_7, t2_8, t2_9, t2_10, t2_11, t2_12, t2_13, t2_14, t2_15, t2_16, t2_17, t2_18, t2_19, t2_20, t2_21, t2_22, t2_23, t2_24, t2_25, t2_26, t2_27, t2_28, t2_29, t2_30, t2_31, t2_32, t2_33, t2_34, t2_35, t2_36, t2_37, t2_38, t2_39, t2_40, t2_41, t2_42, t2_43, t2_44, t2_45, t2_46, t2_47, t2_48, t2_49, t2_50, t2_51, t2_52, t2_53, t2_54, t2_55, t2_56, t2_57, t2_58, t2_59, t2_60, t2_61, t2_62, t2_63, t2_64, t2_65, t2_66, t2_67, t2_68, t2_69, t2_70, t2_71
        );
    // line_d = m_den * zt * z1 = (0,0,0,2tw_y,0,0) * (1,0,...) * (0,0,0,tw_z,0,0)
    // For Z1 affine (Z=1): line_d = m_den * 1 * z1_fp12
    // m_den is at c3, zt is scalar at c0, z1 is at c3
    // m_den * zt = m_den (since zt=1)
    // m_den * z1: (0,0,0,2tw_y,0,0) * (0,0,0,tw_z,0,0)
    // But z1 = twist(Z), and for Z=(1,0) the twist gives (1,0) at c3
    // So z1_fp12 has c3 = (tw_z_re, tw_z_im) = ((1-0), 0) = (1, 0) in Montgomery
    // Actually for general Z: z1_fp12 has c3 = (tw_z_re, tw_z_im)
    // line_d = m_den(c3) * zt(c0) * z1(c3)
    // = sparse Fp12 products
    // For simplicity, use full fp12_mul:
    let (d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38, d39, d40, d41, d42, d43, d44, d45, d46, d47, d48, d49, d50, d51, d52, d53, d54, d55, d56, d57, d58, d59, d60, d61, d62, d63, d64, d65, d66, d67, d68, d69, d70, d71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_mul(
            z,z,z,z,z,z, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, md_r0,md_r1,md_r2,md_r3,md_r4,md_r5,md_i0,md_i1,md_i2,md_i3,md_i4,md_i5, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z,
            one0,one1,one2,one3,one4,one5, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, tw_zr0,tw_zr1,tw_zr2,tw_zr3,tw_zr4,tw_zr5,tw_zi0,tw_zi1,tw_zi2,tw_zi3,tw_zi4,tw_zi5, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z
        );
    // Return (line_n, line_d) as 144 u64
    (n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43, n44, n45, n46, n47, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71,
     d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38, d39, d40, d41, d42, d43, d44, d45, d46, d47, d48, d49, d50, d51, d52, d53, d54, d55, d56, d57, d58, d59, d60, d61, d62, d63, d64, d65, d66, d67, d68, d69, d70, d71)
}

fn main() {
    // Simple test: Fp12 one * one = one
    let z: u64 = 0;
    let one0: u64 = 0x760900000002fffd; let one1: u64 = 0xebf4000bc40c0002;
    let one2: u64 = 0x5f48985753c758ba; let one3: u64 = 0x77ce585370525745;
    let one4: u64 = 0x5c071a97a256ec6d; let one5: u64 = 0x15f65ec3fa80e493;
    // Fp12 one = ((1,0,0,0,0,0), (0,...)) where 1 = R mod p at c0_re
    let (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27, r28, r29, r30, r31, r32, r33, r34, r35, r36, r37, r38, r39, r40, r41, r42, r43, r44, r45, r46, r47, r48, r49, r50, r51, r52, r53, r54, r55, r56, r57, r58, r59, r60, r61, r62, r63, r64, r65, r66, r67, r68, r69, r70, r71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_mul(
            one0,one1,one2,one3,one4,one5, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z,
            one0,one1,one2,one3,one4,one5, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z
        );
    // 1 * 1 = 1: c0_re should be R mod p, rest zero
    assert!(fp_eq(r0, r1, r2, r3, r4, r5, one0, one1, one2, one3, one4, one5));
    assert!(fp_eq(r6, r7, r8, r9, r10, r11, z, z, z, z, z, z));

    // ===== Test line_double with G2 at G1 =====
    // G2 generator Fp2 coords (standard form, to be used with Z=(1,0))
    let (gx0, gx1, gx2, gx3, gx4, gx5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xd48056c8c121bdb8, 0x0bac0326a805bbef, 0xb4510b647ae3d177, 0xc6e47ad4fa403b02, 0x260805272dc51051, 0x024aa2b2f08f0a91);
    let (gx6, gx7, gx8, gx9, gx10, gx11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xe5ac7d055d042b7e, 0x334cf11213945d57, 0xb5da61bbdc7f5049, 0x596bd0d09920b61a, 0x7dacd3a088274f65, 0x13e02b6052719f60);
    let (gy0, gy1, gy2, gy3, gy4, gy5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xe193548608b82801, 0x923ac9cc3baca289, 0x6d429a695160d12c, 0xadfd9baa8cbdd3a7, 0x8cc9cdc6da2e351a, 0x0ce5d527727d6e11);
    let (gy6, gy7, gy8, gy9, gy10, gy11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xaaa9075ff05f79be, 0x3f370d275cec1da1, 0x267492ab572e99ab, 0xcb3e287e85a763af, 0x32acd2b02bc28b99, 0x0606c4a02ea734cc);
    // Z = (1, 0) in Montgomery
    let gz0: u64 = one0; let gz1: u64 = one1; let gz2: u64 = one2;
    let gz3: u64 = one3; let gz4: u64 = one4; let gz5: u64 = one5;
    let gz6: u64 = z; let gz7: u64 = z; let gz8: u64 = z;
    let gz9: u64 = z; let gz10: u64 = z; let gz11: u64 = z;
    // G1 generator Fp coords
    let (px0, px1, px2, px3, px4, px5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xfb3af00adb22c6bb, 0x6c55e83ff97a1aef, 0xa14e3a3f171bac58, 0xc3688c4f9774b905, 0x2695638c4fa9ac0f, 0x17f1d3a73197d794);
    let (py0, py1, py2, py3, py4, py5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0x0caa232946c5e7e1, 0xd03cc744a2888ae4, 0x00db18cb2c04b3ed, 0xfcf5e095d5d00af6, 0xa09e30ed741d8ae4, 0x08b3f481e3aaa0f1);

    let (n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43, n44, n45, n46, n47, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71,
         d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38, d39, d40, d41, d42, d43, d44, d45, d46, d47, d48, d49, d50, d51, d52, d53, d54, d55, d56, d57, d58, d59, d60, d61, d62, d63, d64, d65, d66, d67, d68, d69, d70, d71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        line_double(
            gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11,
            gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11,
            gz0, gz1, gz2, gz3, gz4, gz5, gz6, gz7, gz8, gz9, gz10, gz11,
            px0, px1, px2, px3, px4, px5, py0, py1, py2, py3, py4, py5
        );
    // Verify line numerator c0 (Montgomery form)
    assert!(fp_eq(n0, n1, n2, n3, n4, n5,
        0x7d2c38f459505054, 0x279e4ea81ea03497,
        0x63af772bc266ee9a, 0x99a31cab94e5e649,
        0xdd1e798dc7c11047, 0x04e9c4f0dbe282de));
    assert!(fp_eq(n6, n7, n8, n9, n10, n11,
        0xaeda328755209fbc, 0x9ac7b60b652b83df,
        0x8f517c07dc4d2e0a, 0x43238666843e32fb,
        0xe8c868559f1f80f3, 0x0efcdf27f0bcd79d));
    // Verify denominator c0 (Montgomery form)
    assert!(fp_eq(d0, d1, d2, d3, d4, d5,
        0xbcfa0db4826c93e2, 0xdaaf63d4b656788c,
        0xb3aaf398fdce3dc7, 0xe3c925cec2139894,
        0xf9d9ee29f5a42df8, 0x0753194ee3875d68));
}
