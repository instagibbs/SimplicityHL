    let (zi2_0, zi2_1, zi2_2, zi2_3, zi2_4, zi2_5, zi2_6, zi2_7, zi2_8, zi2_9, zi2_10, zi2_11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(zi0, zi1, zi2, zi3, zi4, zi5, zi6, zi7, zi8, zi9, zi10, zi11, zi0, zi1, zi2, zi3, zi4, zi5, zi6, zi7, zi8, zi9, zi10, zi11);
