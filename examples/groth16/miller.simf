// Twist embedding: map Fp2 x-coordinate to Fp12
// twist(x) has monomial-4 coeff = x_re, monomial-10 coeff = (x_im - x_re)*inv2
// Both live in tower slot c0.c2 (v^2): Fp2 (re, im) encodes (re-im)*x^4 + im*x^10
// So: im = (x_im-x_re)*inv2, re = x_re + (x_im-x_re)*inv2
// Output: 72-u64 Fp12 with only u64[24:36] nonzero
fn make_twist_x(xr0: u64, xr1: u64, xr2: u64, xr3: u64, xr4: u64, xr5: u64, xi0: u64, xi1: u64, xi2: u64, xi3: u64, xi4: u64, xi5: u64) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    let z: u64 = 0;
    let inv2_0: u64 = 0x1804000000015554; let inv2_1: u64 = 0x855000053ab00001;
    let inv2_2: u64 = 0x633cb57c253c276f; let inv2_3: u64 = 0x6e22d1ec31ebb502;
    let inv2_4: u64 = 0xd3916126f2d14ca2; let inv2_5: u64 = 0x17fbb8571a006596;
    let (d0, d1, d2, d3, d4, d5): (u64, u64, u64, u64, u64, u64) = fs(xi0, xi1, xi2, xi3, xi4, xi5, xr0, xr1, xr2, xr3, xr4, xr5);
    let (im0, im1, im2, im3, im4, im5): (u64, u64, u64, u64, u64, u64) = fm(d0, d1, d2, d3, d4, d5, inv2_0, inv2_1, inv2_2, inv2_3, inv2_4, inv2_5);
    let (re0, re1, re2, re3, re4, re5): (u64, u64, u64, u64, u64, u64) = fa(xr0, xr1, xr2, xr3, xr4, xr5, im0, im1, im2, im3, im4, im5);
    (z,z,z,z,z,z, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, re0,re1,re2,re3,re4,re5,im0,im1,im2,im3,im4,im5, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z)
}

