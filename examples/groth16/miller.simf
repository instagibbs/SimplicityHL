    let (xa0, xa1, xa2, xa3, xa4, xa5, xa6, xa7, xa8, xa9, xa10, xa11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, zi2_0, zi2_1, zi2_2, zi2_3, zi2_4, zi2_5, zi2_6, zi2_7, zi2_8, zi2_9, zi2_10, zi2_11);
    let (ya0, ya1, ya2, ya3, ya4, ya5, ya6, ya7, ya8, ya9, ya10, ya11): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, zi3_0, zi3_1, zi3_2, zi3_3, zi3_4, zi3_5, zi3_6, zi3_7, zi3_8, zi3_9, zi3_10, zi3_11);
