    (rx0, rx1, rx2, rx3, rx4, rx5, rx6, rx7, rx8, rx9, rx10, rx11,
     ry0, ry1, ry2, ry3, ry4, ry5, ry6, ry7, ry8, ry9, ry10, ry11,
     rz0, rz1, rz2, rz3, rz4, rz5, rz6, rz7, rz8, rz9, rz10, rz11)
}

fn main() {
    // Simple test: Fp12 one * one = one
    let z: u64 = 0;
    let one0: u64 = 0x760900000002fffd; let one1: u64 = 0xebf4000bc40c0002;
    let one2: u64 = 0x5f48985753c758ba; let one3: u64 = 0x77ce585370525745;
    let one4: u64 = 0x5c071a97a256ec6d; let one5: u64 = 0x15f65ec3fa80e493;
    // Fp12 one = ((1,0,0,0,0,0), (0,...)) where 1 = R mod p at c0_re
    let (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27, r28, r29, r30, r31, r32, r33, r34, r35, r36, r37, r38, r39, r40, r41, r42, r43, r44, r45, r46, r47, r48, r49, r50, r51, r52, r53, r54, r55, r56, r57, r58, r59, r60, r61, r62, r63, r64, r65, r66, r67, r68, r69, r70, r71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_mul(
            one0,one1,one2,one3,one4,one5, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z,
            one0,one1,one2,one3,one4,one5, z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z, z,z,z,z,z,z,z,z,z,z,z,z
        );
    // 1 * 1 = 1: c0_re should be R mod p, rest zero
    assert!(fp_eq(r0, r1, r2, r3, r4, r5, one0, one1, one2, one3, one4, one5));
    assert!(fp_eq(r6, r7, r8, r9, r10, r11, z, z, z, z, z, z));

    // ===== Test line_double with G2 at G1 =====
    // G2 generator Fp2 coords (standard form, to be used with Z=(1,0))
    let (gx0, gx1, gx2, gx3, gx4, gx5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xd48056c8c121bdb8, 0x0bac0326a805bbef, 0xb4510b647ae3d177, 0xc6e47ad4fa403b02, 0x260805272dc51051, 0x024aa2b2f08f0a91);
    let (gx6, gx7, gx8, gx9, gx10, gx11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xe5ac7d055d042b7e, 0x334cf11213945d57, 0xb5da61bbdc7f5049, 0x596bd0d09920b61a, 0x7dacd3a088274f65, 0x13e02b6052719f60);
    let (gy0, gy1, gy2, gy3, gy4, gy5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xe193548608b82801, 0x923ac9cc3baca289, 0x6d429a695160d12c, 0xadfd9baa8cbdd3a7, 0x8cc9cdc6da2e351a, 0x0ce5d527727d6e11);
    let (gy6, gy7, gy8, gy9, gy10, gy11): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xaaa9075ff05f79be, 0x3f370d275cec1da1, 0x267492ab572e99ab, 0xcb3e287e85a763af, 0x32acd2b02bc28b99, 0x0606c4a02ea734cc);
    // Z = (1, 0) in Montgomery
    let gz0: u64 = one0; let gz1: u64 = one1; let gz2: u64 = one2;
    let gz3: u64 = one3; let gz4: u64 = one4; let gz5: u64 = one5;
    let gz6: u64 = z; let gz7: u64 = z; let gz8: u64 = z;
    let gz9: u64 = z; let gz10: u64 = z; let gz11: u64 = z;
    // G1 generator Fp coords
    let (px0, px1, px2, px3, px4, px5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0xfb3af00adb22c6bb, 0x6c55e83ff97a1aef, 0xa14e3a3f171bac58, 0xc3688c4f9774b905, 0x2695638c4fa9ac0f, 0x17f1d3a73197d794);
    let (py0, py1, py2, py3, py4, py5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(0x0caa232946c5e7e1, 0xd03cc744a2888ae4, 0x00db18cb2c04b3ed, 0xfcf5e095d5d00af6, 0xa09e30ed741d8ae4, 0x08b3f481e3aaa0f1);

    let (n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43, n44, n45, n46, n47, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71,
         d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38, d39, d40, d41, d42, d43, d44, d45, d46, d47, d48, d49, d50, d51, d52, d53, d54, d55, d56, d57, d58, d59, d60, d61, d62, d63, d64, d65, d66, d67, d68, d69, d70, d71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        line_double(
            gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11,
            gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11,
            gz0, gz1, gz2, gz3, gz4, gz5, gz6, gz7, gz8, gz9, gz10, gz11,
            px0, px1, px2, px3, px4, px5, py0, py1, py2, py3, py4, py5
        );
    // Verify line numerator c0 (Montgomery form)
    assert!(fp_eq(n0, n1, n2, n3, n4, n5,
        0x7d2c38f459505054, 0x279e4ea81ea03497,
        0x63af772bc266ee9a, 0x99a31cab94e5e649,
        0xdd1e798dc7c11047, 0x04e9c4f0dbe282de));
    assert!(fp_eq(n6, n7, n8, n9, n10, n11,
        0xaeda328755209fbc, 0x9ac7b60b652b83df,
        0x8f517c07dc4d2e0a, 0x43238666843e32fb,
        0xe8c868559f1f80f3, 0x0efcdf27f0bcd79d));
    // Verify denominator c0 (Montgomery form)
    assert!(fp_eq(d0, d1, d2, d3, d4, d5,
        0xbcfa0db4826c93e2, 0xdaaf63d4b656788c,
        0xb3aaf398fdce3dc7, 0xe3c925cec2139894,
        0xf9d9ee29f5a42df8, 0x0753194ee3875d68));

    // ===== Test fp2_inv: inv(2+3i) * (2+3i) = (1, 0) =====
    let (two0, two1, two2, two3, two4, two5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(2, 0, 0, 0, 0, 0);
    let (thr0, thr1, thr2, thr3, thr4, thr5): (u64, u64, u64, u64, u64, u64) = fp_to_mont(3, 0, 0, 0, 0, 0);
    let (inv_r0, inv_r1, inv_r2, inv_r3, inv_r4, inv_r5, inv_i0, inv_i1, inv_i2, inv_i3, inv_i4, inv_i5): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = fp2_inv(two0, two1, two2, two3, two4, two5, thr0, thr1, thr2, thr3, thr4, thr5);
    // inv * (2+3i) should be (1, 0) in Montgomery form
    let (pr0, pr1, pr2, pr3, pr4, pr5, pi0, pi1, pi2, pi3, pi4, pi5): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = f2m(inv_r0, inv_r1, inv_r2, inv_r3, inv_r4, inv_r5, inv_i0, inv_i1, inv_i2, inv_i3, inv_i4, inv_i5, two0, two1, two2, two3, two4, two5, thr0, thr1, thr2, thr3, thr4, thr5);
    assert!(fp_eq(pr0, pr1, pr2, pr3, pr4, pr5, one0, one1, one2, one3, one4, one5));
    assert!(fp_eq(pi0, pi1, pi2, pi3, pi4, pi5, z, z, z, z, z, z));

    // ===== Test jac_to_affine: converting G2 gen (Z=1) back should give same coords =====
    let (ax0, ax1, ax2, ax3, ax4, ax5, ax6, ax7, ax8, ax9, ax10, ax11,
         ay0, ay1, ay2, ay3, ay4, ay5, ay6, ay7, ay8, ay9, ay10, ay11):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        jac_to_affine(
            gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11,
            gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11,
            gz0, gz1, gz2, gz3, gz4, gz5, gz6, gz7, gz8, gz9, gz10, gz11);
    assert!(fp_eq(ax0, ax1, ax2, ax3, ax4, ax5, gx0, gx1, gx2, gx3, gx4, gx5));
    assert!(fp_eq(ax6, ax7, ax8, ax9, ax10, ax11, gx6, gx7, gx8, gx9, gx10, gx11));
    assert!(fp_eq(ay0, ay1, ay2, ay3, ay4, ay5, gy0, gy1, gy2, gy3, gy4, gy5));
    assert!(fp_eq(ay6, ay7, ay8, ay9, ay10, ay11, gy6, gy7, gy8, gy9, gy10, gy11));

    // ===== Chain 2 doubling steps of Miller loop =====
    // Step 0: f_num = 1^2 * line_n = n0, R = g2dbl(G2)
    let (r_x0, r_x1, r_x2, r_x3, r_x4, r_x5, r_x6, r_x7, r_x8, r_x9, r_x10, r_x11,
         r_y0, r_y1, r_y2, r_y3, r_y4, r_y5, r_y6, r_y7, r_y8, r_y9, r_y10, r_y11,
         r_z0, r_z1, r_z2, r_z3, r_z4, r_z5, r_z6, r_z7, r_z8, r_z9, r_z10, r_z11):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        g2dbl(gx0, gx1, gx2, gx3, gx4, gx5, gx6, gx7, gx8, gx9, gx10, gx11,
              gy0, gy1, gy2, gy3, gy4, gy5, gy6, gy7, gy8, gy9, gy10, gy11,
              gz0, gz1, gz2, gz3, gz4, gz5, gz6, gz7, gz8, gz9, gz10, gz11);

    // Convert R from Jacobian to affine so line_double works correctly
    let (ra_x0, ra_x1, ra_x2, ra_x3, ra_x4, ra_x5, ra_x6, ra_x7, ra_x8, ra_x9, ra_x10, ra_x11,
         ra_y0, ra_y1, ra_y2, ra_y3, ra_y4, ra_y5, ra_y6, ra_y7, ra_y8, ra_y9, ra_y10, ra_y11):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
         u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        jac_to_affine(r_x0, r_x1, r_x2, r_x3, r_x4, r_x5, r_x6, r_x7, r_x8, r_x9, r_x10, r_x11,
                      r_y0, r_y1, r_y2, r_y3, r_y4, r_y5, r_y6, r_y7, r_y8, r_y9, r_y10, r_y11,
                      r_z0, r_z1, r_z2, r_z3, r_z4, r_z5, r_z6, r_z7, r_z8, r_z9, r_z10, r_z11);

    // Verify affine R coords (from py_ecc)
    assert!(fp_eq(ra_x0, ra_x1, ra_x2, ra_x3, ra_x4, ra_x5,
        0xe9d9e2da9620f98b, 0x54f1199346b97f36,
        0x3db3b820376bed27, 0xcfdb31c9b0b64f4c,
        0x41d7c12786354493, 0x05710794c255c064));
    assert!(fp_eq(ra_x6, ra_x7, ra_x8, ra_x9, ra_x10, ra_x11,
        0xd6c1d3ca6ea0d06e, 0xda0cbd905595489f,
        0x4f5352d43479221d, 0x8ade5d736f8c97e0,
        0x48cc8433925ef70e, 0x08d7ea71ea91ef81));

    // Step 1: f_num = n0^2 * line_n(R_aff, P), R = g2dbl(R_aff)
    let (fsq_0, fsq_1, fsq_2, fsq_3, fsq_4, fsq_5, fsq_6, fsq_7, fsq_8, fsq_9, fsq_10, fsq_11, fsq_12, fsq_13, fsq_14, fsq_15, fsq_16, fsq_17, fsq_18, fsq_19, fsq_20, fsq_21, fsq_22, fsq_23, fsq_24, fsq_25, fsq_26, fsq_27, fsq_28, fsq_29, fsq_30, fsq_31, fsq_32, fsq_33, fsq_34, fsq_35, fsq_36, fsq_37, fsq_38, fsq_39, fsq_40, fsq_41, fsq_42, fsq_43, fsq_44, fsq_45, fsq_46, fsq_47, fsq_48, fsq_49, fsq_50, fsq_51, fsq_52, fsq_53, fsq_54, fsq_55, fsq_56, fsq_57, fsq_58, fsq_59, fsq_60, fsq_61, fsq_62, fsq_63, fsq_64, fsq_65, fsq_66, fsq_67, fsq_68, fsq_69, fsq_70, fsq_71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        fp12_mul(n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43, n44, n45, n46, n47, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71,
                 n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43, n44, n45, n46, n47, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71);

    // Compute line at R_aff (now with Z=(1,0))
    let (ln1_0, ln1_1, ln1_2, ln1_3, ln1_4, ln1_5, ln1_6, ln1_7, ln1_8, ln1_9, ln1_10, ln1_11, ln1_12, ln1_13, ln1_14, ln1_15, ln1_16, ln1_17, ln1_18, ln1_19, ln1_20, ln1_21, ln1_22, ln1_23, ln1_24, ln1_25, ln1_26, ln1_27, ln1_28, ln1_29, ln1_30, ln1_31, ln1_32, ln1_33, ln1_34, ln1_35, ln1_36, ln1_37, ln1_38, ln1_39, ln1_40, ln1_41, ln1_42, ln1_43, ln1_44, ln1_45, ln1_46, ln1_47, ln1_48, ln1_49, ln1_50, ln1_51, ln1_52, ln1_53, ln1_54, ln1_55, ln1_56, ln1_57, ln1_58, ln1_59, ln1_60, ln1_61, ln1_62, ln1_63, ln1_64, ln1_65, ln1_66, ln1_67, ln1_68, ln1_69, ln1_70, ln1_71,
         ld1_0, ld1_1, ld1_2, ld1_3, ld1_4, ld1_5, ld1_6, ld1_7, ld1_8, ld1_9, ld1_10, ld1_11, ld1_12, ld1_13, ld1_14, ld1_15, ld1_16, ld1_17, ld1_18, ld1_19, ld1_20, ld1_21, ld1_22, ld1_23, ld1_24, ld1_25, ld1_26, ld1_27, ld1_28, ld1_29, ld1_30, ld1_31, ld1_32, ld1_33, ld1_34, ld1_35, ld1_36, ld1_37, ld1_38, ld1_39, ld1_40, ld1_41, ld1_42, ld1_43, ld1_44, ld1_45, ld1_46, ld1_47, ld1_48, ld1_49, ld1_50, ld1_51, ld1_52, ld1_53, ld1_54, ld1_55, ld1_56, ld1_57, ld1_58, ld1_59, ld1_60, ld1_61, ld1_62, ld1_63, ld1_64, ld1_65, ld1_66, ld1_67, ld1_68, ld1_69, ld1_70, ld1_71):
