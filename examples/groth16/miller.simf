    let (mn_i0, mn_i1, mn_i2, mn_i3, mn_i4, mn_i5): (u64, u64, u64, u64, u64, u64) = fm(x1sq_i0, x1sq_i1, x1sq_i2, x1sq_i3, x1sq_i4, x1sq_i5, three0, three1, three2, three3, three4, three5);
