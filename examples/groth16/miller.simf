        make_twist_x(xr0, xr1, xr2, xr3, xr4, xr5, xr6, xr7, xr8, xr9, xr10, xr11);
    let (tyr0, tyr1, tyr2, tyr3, tyr4, tyr5, tyr6, tyr7, tyr8, tyr9, tyr10, tyr11, tyr12, tyr13, tyr14, tyr15, tyr16, tyr17, tyr18, tyr19, tyr20, tyr21, tyr22, tyr23, tyr24, tyr25, tyr26, tyr27, tyr28, tyr29, tyr30, tyr31, tyr32, tyr33, tyr34, tyr35, tyr36, tyr37, tyr38, tyr39, tyr40, tyr41, tyr42, tyr43, tyr44, tyr45, tyr46, tyr47, tyr48, tyr49, tyr50, tyr51, tyr52, tyr53, tyr54, tyr55, tyr56, tyr57, tyr58, tyr59, tyr60, tyr61, tyr62, tyr63, tyr64, tyr65, tyr66, tyr67, tyr68, tyr69, tyr70, tyr71):
        (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) =
        make_twist_y(yr0, yr1, yr2, yr3, yr4, yr5, yr6, yr7, yr8, yr9, yr10, yr11);
    let (txq0, txq1, txq2, txq3, txq4, txq5, txq6, txq7, txq8, txq9, txq10, txq11, txq12, txq13, txq14, txq15, txq16, txq17, txq18, txq19, txq20, txq21, txq22, txq23, txq24, txq25, txq26, txq27, txq28, txq29, txq30, txq31, txq32, txq33, txq34, txq35, txq36, txq37, txq38, txq39, txq40, txq41, txq42, txq43, txq44, txq45, txq46, txq47, txq48, txq49, txq50, txq51, txq52, txq53, txq54, txq55, txq56, txq57, txq58, txq59, txq60, txq61, txq62, txq63, txq64, txq65, txq66, txq67, txq68, txq69, txq70, txq71):
