) -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64,
      u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    // Correct twist embedding for secant line: line_n = (tyq-tyr)*(xt-txr) - (txq-txr)*(yt-tyr), line_d = txq-txr
    let (txr0, txr1, txr2, txr3, txr4, txr5, txr6, txr7, txr8, txr9, txr10, txr11, txr12, txr13, txr14, txr15, txr16, txr17, txr18, txr19, txr20, txr21, txr22, txr23, txr24, txr25, txr26, txr27, txr28, txr29, txr30, txr31, txr32, txr33, txr34, txr35, txr36, txr37, txr38, txr39, txr40, txr41, txr42, txr43, txr44, txr45, txr46, txr47, txr48, txr49, txr50, txr51, txr52, txr53, txr54, txr55, txr56, txr57, txr58, txr59, txr60, txr61, txr62, txr63, txr64, txr65, txr66, txr67, txr68, txr69, txr70, txr71):
