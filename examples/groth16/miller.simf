// Pack/unpack Fp (6 u64) <-> (u256, u128)
fn pk(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> (u256, u128) {
    (<((u64,u64),(u64,u64))>::into(((a3, a2), (a1, a0))), <(u64,u64)>::into((a5, a4)))
}
fn up(v: (u256, u128)) -> (u64, u64, u64, u64, u64, u64) {
    let (lo, hi): (u256, u128) = v;
    let ((a3, a2), (a1, a0)): ((u64, u64), (u64, u64)) = <u256>::into(lo);
    let (a5, a4): (u64, u64) = <u128>::into(hi);
    (a0, a1, a2, a3, a4, a5)
}

