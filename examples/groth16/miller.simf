    let (md_i0, md_i1, md_i2, md_i3, md_i4, md_i5): (u64, u64, u64, u64, u64, u64) = fa(tw_yi0, tw_yi1, tw_yi2, tw_yi3, tw_yi4, tw_yi5, tw_yi0, tw_yi1, tw_yi2, tw_yi3, tw_yi4, tw_yi5);
    // -tw_x (for diff1)
    let (neg_xr0, neg_xr1, neg_xr2, neg_xr3, neg_xr4, neg_xr5): (u64, u64, u64, u64, u64, u64) = fs(z,z,z,z,z,z, tw_xr0, tw_xr1, tw_xr2, tw_xr3, tw_xr4, tw_xr5);
    let (neg_xi0, neg_xi1, neg_xi2, neg_xi3, neg_xi4, neg_xi5): (u64, u64, u64, u64, u64, u64) = fs(z,z,z,z,z,z, tw_xi0, tw_xi1, tw_xi2, tw_xi3, tw_xi4, tw_xi5);
    // -tw_y (for diff2)
    let (neg_yr0, neg_yr1, neg_yr2, neg_yr3, neg_yr4, neg_yr5): (u64, u64, u64, u64, u64, u64) = fs(z,z,z,z,z,z, tw_yr0, tw_yr1, tw_yr2, tw_yr3, tw_yr4, tw_yr5);
    let (neg_yi0, neg_yi1, neg_yi2, neg_yi3, neg_yi4, neg_yi5): (u64, u64, u64, u64, u64, u64) = fs(z,z,z,z,z,z, tw_yi0, tw_yi1, tw_yi2, tw_yi3, tw_yi4, tw_yi5);
    // term1 = m_num * diff1 = (0,0,3tw_x^2,0,0,0) * (0,-tw_x,0,(xP,0),0,0)
    let (t1_0, t1_1, t1_2, t1_3, t1_4, t1_5, t1_6, t1_7, t1_8, t1_9, t1_10, t1_11, t1_12, t1_13, t1_14, t1_15, t1_16, t1_17, t1_18, t1_19, t1_20, t1_21, t1_22, t1_23, t1_24, t1_25, t1_26, t1_27, t1_28, t1_29, t1_30, t1_31, t1_32, t1_33, t1_34, t1_35, t1_36, t1_37, t1_38, t1_39, t1_40, t1_41, t1_42, t1_43, t1_44, t1_45, t1_46, t1_47, t1_48, t1_49, t1_50, t1_51, t1_52, t1_53, t1_54, t1_55, t1_56, t1_57, t1_58, t1_59, t1_60, t1_61, t1_62, t1_63, t1_64, t1_65, t1_66, t1_67, t1_68, t1_69, t1_70, t1_71):
